#!/usr/bin/env bash
set -Eeuo pipefail

# fedora-session: no-systemd GNOME supervisor for a PRoot guest.
# Marker used by start/stop and diagnostics: fedora-shell-session-v1

FEDORA_SESSION_LOG="${FEDORA_SESSION_LOG:-${XDG_RUNTIME_DIR:-/tmp}/fedora-session.log}"
FEDORA_SESSION_RUNTIME="${FEDORA_SESSION_RUNTIME:-/tmp/fedora-runtime}"
FEDORA_DISPLAY="${DISPLAY:-:0}"
FEDORA_NESTED_SCALE="${FEDORA_NESTED_SCALE:-1}"
FEDORA_NESTED_MODE="${FEDORA_NESTED_MODE:-auto}"
FEDORA_ALLOW_X11="${FEDORA_ALLOW_X11:-0}"

mkdir -p "$FEDORA_SESSION_RUNTIME" "$(dirname -- "$FEDORA_SESSION_LOG")"
chmod 700 "$FEDORA_SESSION_RUNTIME" 2>/dev/null || true
touch "$FEDORA_SESSION_LOG"

session_log() {
  printf '[fedora-session] %s\n' "$*" | tee -a "$FEDORA_SESSION_LOG" >&2
}

session_die() {
  session_log "ERROR: $*"
  exit 1
}

# dbus-run-session supplies the session bus and removes it when the compositor
# exits. Re-exec keeps the inside-bus path easy to inspect in logs.
if [[ "${1:-}" != --inside-dbus ]]; then
  command -v dbus-run-session >/dev/null 2>&1 || session_die "dbus-run-session is missing"
  export XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME"
  exec dbus-run-session -- "$0" --inside-dbus "$@"
fi
shift

export DISPLAY="$FEDORA_DISPLAY"
export XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME"
export XDG_CURRENT_DESKTOP="GNOME"
export XDG_SESSION_DESKTOP="gnome"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"

child_pids=()
cleanup() {
  local pid
  for pid in "${child_pids[@]:-}"; do
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
  done
  rm -f -- "$FEDORA_SESSION_RUNTIME/fedora-session-state.env"
}
trap cleanup EXIT INT TERM

start_optional() {
  local name="$1"
  shift
  if ! command -v "$name" >/dev/null 2>&1; then
    session_log "optional process not installed: $name"
    return 0
  fi
  "$name" "$@" >> "$FEDORA_SESSION_LOG" 2>&1 &
  child_pids+=("$!")
}

# PipeWire and portals are user processes here. They may still fail if the
# Android/Termux audio transport or required kernel feature is unavailable.
start_optional pipewire
start_optional wireplumber
start_optional pipewire-pulse
start_optional xdg-desktop-portal
start_optional xdg-desktop-portal-gtk

if command -v gnome-keyring-daemon >/dev/null 2>&1; then
  keyring_env="$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null || true)"
  if [[ -n "$keyring_env" ]]; then
    # The command emits shell assignments from the trusted Fedora package.
    eval "$keyring_env"
  fi
fi

has_option() {
  local command_name="$1"
  local option="$2"
  "$command_name" --help 2>&1 | grep -Fq -- "$option"
}

wait_for_nested_socket() {
  local before="$1"
  local tries=0
  local display_name=""
  local candidate
  while (( tries < 100 )); do
    display_name="$(grep -Eo 'wayland-[0-9]+' "$FEDORA_SESSION_LOG" | tail -n 1 || true)"
    if [[ -n "$display_name" && -S "$FEDORA_SESSION_RUNTIME/$display_name" ]]; then
      printf '%s\n' "$display_name"
      return 0
    fi
    for candidate in "$FEDORA_SESSION_RUNTIME"/wayland-*; do
      [[ -S "$candidate" ]] || continue
      display_name="${candidate##*/}"
      if ! grep -Fxq "$display_name" <<< "$before"; then
        printf '%s\n' "$display_name"
        return 0
      fi
    done
    sleep 0.1
    ((tries += 1))
  done
  return 1
}

launch_terminal() {
  local terminal
  if command -v ptyxis >/dev/null 2>&1; then
    terminal=ptyxis
  elif command -v gnome-console >/dev/null 2>&1; then
    terminal=gnome-console
  elif command -v gnome-terminal >/dev/null 2>&1; then
    terminal=gnome-terminal
  else
    session_log "No GNOME terminal package found; open applications from the shell overview."
    return 0
  fi
  "$terminal" >> "$FEDORA_SESSION_LOG" 2>&1 &
  child_pids+=("$!")
}

run_wayland_nested() {
  has_option gnome-shell --nested || return 1
  has_option gnome-shell --wayland || return 1

  local before shell_pid nested_display
  before="$(find "$FEDORA_SESSION_RUNTIME" -maxdepth 1 -type s -name 'wayland-*' -exec basename {} \; 2>/dev/null || true)"
  session_log "Starting GNOME Shell nested Wayland on outer DISPLAY=$DISPLAY"
  local shell_args=(--nested --wayland)
  if has_option gnome-shell --sm-disable; then
    shell_args+=(--sm-disable)
  fi
  if [[ "$FEDORA_NESTED_SCALE" != 1 ]]; then
    export MUTTER_DEBUG_DUMMY_MONITOR_SCALES="$FEDORA_NESTED_SCALE"
  fi
  if [[ -n "${FEDORA_NESTED_MODE_SPECS:-}" ]]; then
    export MUTTER_DEBUG_DUMMY_MODE_SPECS="$FEDORA_NESTED_MODE_SPECS"
  fi

  unset WAYLAND_DISPLAY
  gnome-shell "${shell_args[@]}" >> "$FEDORA_SESSION_LOG" 2>&1 &
  shell_pid="$!"
  child_pids+=("$shell_pid")

  if ! nested_display="$(wait_for_nested_socket "$before")"; then
    session_log "GNOME Shell did not publish a nested Wayland socket"
    return 1
  fi
  export WAYLAND_DISPLAY="$nested_display"
  export XDG_SESSION_TYPE=wayland
  {
    printf 'WAYLAND_DISPLAY=%q\n' "$WAYLAND_DISPLAY"
    printf 'XDG_RUNTIME_DIR=%q\n' "$XDG_RUNTIME_DIR"
    printf 'XDG_SESSION_TYPE=%q\n' "$XDG_SESSION_TYPE"
    printf 'DISPLAY=%q\n' "$DISPLAY"
  } > "$FEDORA_SESSION_RUNTIME/fedora-session-state.env"
  chmod 600 "$FEDORA_SESSION_RUNTIME/fedora-session-state.env" 2>/dev/null || true
  session_log "Desktop session: Wayland ($WAYLAND_DISPLAY); transport: X11 ($DISPLAY)"

  if command -v gnome-settings-daemon >/dev/null 2>&1; then
    gnome-settings-daemon --replace >> "$FEDORA_SESSION_LOG" 2>&1 &
    child_pids+=("$!")
  fi
  launch_terminal
  wait "$shell_pid"
}

run_mutter_nested() {
  command -v mutter >/dev/null 2>&1 || return 1
  has_option mutter --nested || return 1
  local before compositor_pid nested_display
  before="$(find "$FEDORA_SESSION_RUNTIME" -maxdepth 1 -type s -name 'wayland-*' -exec basename {} \; 2>/dev/null || true)"
  session_log "GNOME Shell nested option unavailable; trying Mutter Wayland transport (PARTIAL)"
  unset WAYLAND_DISPLAY
  mutter --wayland --nested >> "$FEDORA_SESSION_LOG" 2>&1 &
  compositor_pid="$!"
  child_pids+=("$compositor_pid")
  if ! nested_display="$(wait_for_nested_socket "$before")"; then
    session_log "Mutter did not publish a nested Wayland socket"
    return 1
  fi
  export WAYLAND_DISPLAY="$nested_display"
  export XDG_SESSION_TYPE=wayland
  {
    printf 'WAYLAND_DISPLAY=%q\n' "$WAYLAND_DISPLAY"
    printf 'XDG_RUNTIME_DIR=%q\n' "$XDG_RUNTIME_DIR"
    printf 'XDG_SESSION_TYPE=%q\n' "$XDG_SESSION_TYPE"
    printf 'DISPLAY=%q\n' "$DISPLAY"
  } > "$FEDORA_SESSION_RUNTIME/fedora-session-state.env"
  chmod 600 "$FEDORA_SESSION_RUNTIME/fedora-session-state.env" 2>/dev/null || true
  session_log "Desktop transport is Wayland, but GNOME Shell is not running"
  launch_terminal
  wait "$compositor_pid"
}

run_x11_fallback() {
  fedora_is_true "$FEDORA_ALLOW_X11" || return 1
  has_option gnome-shell --x11 || return 1
  export XDG_SESSION_TYPE=x11
  unset WAYLAND_DISPLAY
  session_log "WARNING: explicit temporary GNOME X11 fallback enabled"
  local shell_args=(--x11)
  if has_option gnome-shell --sm-disable; then
    shell_args+=(--sm-disable)
  fi
  gnome-shell "${shell_args[@]}" >> "$FEDORA_SESSION_LOG" 2>&1 &
  local shell_pid="$!"
  child_pids+=("$shell_pid")
  wait "$shell_pid"
}

fedora_is_true() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

case "$FEDORA_NESTED_MODE" in
  wayland|auto)
    if run_wayland_nested; then
      exit 0
    fi
    if [[ "$FEDORA_NESTED_MODE" == wayland ]]; then
      session_die "GNOME nested Wayland is unavailable; refusing silent X11 fallback"
    fi
    if run_mutter_nested; then
      exit 0
    fi
    ;;
  mutter)
    run_mutter_nested || session_die "Mutter nested Wayland is unavailable"
    exit 0
    ;;
  x11)
    run_x11_fallback || session_die "explicit X11 fallback requested but unavailable"
    exit 0
    ;;
  *)
    session_die "Unknown FEDORA_NESTED_MODE=$FEDORA_NESTED_MODE"
    ;;
esac

if run_x11_fallback; then
  exit 0
fi

session_die "No supported GNOME display mode found. See $FEDORA_SESSION_LOG"
