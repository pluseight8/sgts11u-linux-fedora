#!/usr/bin/env bash
set -Eeuo pipefail

# fedora-session: no-systemd GNOME supervisor for a PRoot guest.
# Marker used by start/stop and diagnostics: fedora-shell-session-v1

FEDORA_SESSION_LOG="${FEDORA_SESSION_LOG:-${XDG_RUNTIME_DIR:-/tmp}/fedora-session.log}"
FEDORA_SESSION_RUNTIME="${FEDORA_SESSION_RUNTIME:-/tmp/fedora-runtime}"
FEDORA_DISPLAY="${DISPLAY:-:0}"
FEDORA_NESTED_SCALE="${FEDORA_NESTED_SCALE:-1}"
FEDORA_NESTED_MODE="${FEDORA_NESTED_MODE:-auto}"
FEDORA_NESTED_XWAYLAND="${FEDORA_NESTED_XWAYLAND:-auto}"
FEDORA_DEVKIT_GDK_BACKEND="${FEDORA_DEVKIT_GDK_BACKEND:-x11}"
FEDORA_DEVKIT_PIPEWIRE="${FEDORA_DEVKIT_PIPEWIRE:-auto}"
FEDORA_DEVKIT_PIPEWIRE_CONFIG="${FEDORA_DEVKIT_PIPEWIRE_CONFIG:-/etc/fedora-shell/pipewire-devkit.conf}"
FEDORA_DEVKIT_DEBUG="${FEDORA_DEVKIT_DEBUG:-0}"
# GNOME 50 constructs TimeLimitsManager unconditionally and opens Gio.DBus.system
# during shell startup. A PRoot guest has no Android/system bus, so provide a
# Fedora-local compatibility endpoint instead of letting that connection abort
# the shell. This is deliberately not an Android bus alias and has no service
# activation directories.
FEDORA_SYSTEM_BUS_MODE="${FEDORA_SYSTEM_BUS_MODE:-private}"
FEDORA_SYSTEMD_MARKER_MASKED="${FEDORA_SYSTEMD_MARKER_MASKED:-0}"
FEDORA_LINUX_MODE_STOP_REQUEST="${FEDORA_LINUX_MODE_STOP_REQUEST:-}"
FEDORA_ALLOW_X11="${FEDORA_ALLOW_X11:-0}"
FEDORA_PORTAL_MODE="${FEDORA_PORTAL_MODE:-auto}"
FEDORA_CALENDAR_MODE="${FEDORA_CALENDAR_MODE:-auto}"
FEDORA_MEMORY_PROFILE="${FEDORA_MEMORY_PROFILE:-balanced}"
FEDORA_AUDIO_MODE="${FEDORA_AUDIO_MODE:-auto}"
FEDORA_SETTINGS_DAEMON="${FEDORA_SETTINGS_DAEMON:-auto}"
FEDORA_LAUNCH_TERMINAL="${FEDORA_LAUNCH_TERMINAL:-auto}"
FEDORA_KEYRING_MODE="${FEDORA_KEYRING_MODE:-auto}"
FEDORA_SEARCH_MODE="${FEDORA_SEARCH_MODE:-auto}"
FEDORA_ANDROID_APPS_MODE="${FEDORA_ANDROID_APPS_MODE:-auto}"
FEDORA_ANDROID_APPS_SCOPE="${FEDORA_ANDROID_APPS_SCOPE:-all}"
FEDORA_KEYBOARD_MODE="${FEDORA_KEYBOARD_MODE:-linux}"
FEDORA_ANDROID_BRIDGE_DIR="${FEDORA_ANDROID_BRIDGE_DIR:-/tmp/fedora-runtime/android-bridge}"

session_path_parents_safe() {
  local path="$1"
  local current="${path%/*}"

  case "$path" in
    /*) ;;
    *) return 1 ;;
  esac
  case "$path" in
    */../*|*/..|*/./*|*/.) return 1 ;;
  esac
  [[ -n "$current" ]] || current="/"
  while [[ "$current" != "/" ]]; do
    [[ ! -L "$current" && ( ! -e "$current" || -d "$current" ) ]] || return 1
    current="${current%/*}"
    [[ -n "$current" ]] || current="/"
  done
}

session_runtime_parent="$(dirname -- "$FEDORA_SESSION_RUNTIME")"
session_log_parent="$(dirname -- "$FEDORA_SESSION_LOG")"
if ! session_path_parents_safe "$FEDORA_SESSION_RUNTIME" \
  || ! session_path_parents_safe "$FEDORA_SESSION_LOG" \
  || [[ -L "$FEDORA_SESSION_RUNTIME" \
  || ( -e "$FEDORA_SESSION_RUNTIME" && ! -d "$FEDORA_SESSION_RUNTIME" ) \
  || -L "$session_runtime_parent" \
  || ( -e "$session_runtime_parent" && ! -d "$session_runtime_parent" ) ]]; then
  printf '[fedora-session] ERROR: unsafe Fedora runtime path: %s\n' "$FEDORA_SESSION_RUNTIME" >&2
  exit 1
fi
if [[ -L "$session_log_parent" \
  || ( -e "$session_log_parent" && ! -d "$session_log_parent" ) ]]; then
  printf '[fedora-session] ERROR: unsafe Fedora log directory: %s\n' "$session_log_parent" >&2
  exit 1
fi
mkdir -p "$FEDORA_SESSION_RUNTIME" "$session_log_parent"
[[ -d "$FEDORA_SESSION_RUNTIME" && ! -L "$FEDORA_SESSION_RUNTIME" ]] || {
  printf '[fedora-session] ERROR: Fedora runtime directory is unavailable: %s\n' "$FEDORA_SESSION_RUNTIME" >&2
  exit 1
}
[[ -d "$session_log_parent" && ! -L "$session_log_parent" ]] || {
  printf '[fedora-session] ERROR: Fedora log directory is unavailable: %s\n' "$session_log_parent" >&2
  exit 1
}
if [[ -L "$FEDORA_SESSION_LOG" \
  || ( -e "$FEDORA_SESSION_LOG" && ! -f "$FEDORA_SESSION_LOG" ) ]]; then
  printf '[fedora-session] ERROR: unsafe Fedora session log path: %s\n' "$FEDORA_SESSION_LOG" >&2
  exit 1
fi
chmod 700 "$FEDORA_SESSION_RUNTIME" 2>/dev/null || true
touch "$FEDORA_SESSION_LOG"
: > "$FEDORA_SESSION_LOG"

# Fedora packages may leave the logind discovery marker behind even though a
# PRoot guest has no systemd PID 1. GNOME Shell uses this marker (rather than
# checking PID 1) to decide whether to instantiate its systemd LoginManager.
# If the marker is stale, Shell then asks the private session bus for
# org.freedesktop.login1 on the system bus and can abort during TimeLimitsManager
# startup if that bus is absent. Hide only this exact marker for the lifetime of
# this session; never alter Android /run or a real systemd installation.
systemd_marker_hidden="${FEDORA_SYSTEMD_MARKER_HIDDEN:-0}"
systemd_marker_backup="$FEDORA_SESSION_RUNTIME/systemd-seats-marker"
local_settings_backup="$FEDORA_SESSION_RUNTIME/fedora-local-settings.backup"
systemd_pid1_active() {
  [[ -r /proc/1/comm ]] || return 1
  [[ "$(< /proc/1/comm)" == systemd ]]
}

# `kill -0` also succeeds for a zombie until its parent reaps it. Treating a
# dead viewer or compositor as alive can publish a false-ready session and
# leave the user with a black surface. Keep this check local to Fedora/PRoot
# processes; it never inspects or controls Android services.
process_is_live() {
  local pid="$1"
  local state=""
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if [[ -r "/proc/$pid/stat" ]]; then
    state="$(sed -n 's/^[^)]*) \([A-Z]\) .*/\1/p' "/proc/$pid/stat" 2>/dev/null || true)"
    [[ -z "$state" || "$state" != Z ]] || return 1
  fi
  return 0
}

hide_stale_systemd_marker() {
  if [[ "$FEDORA_SYSTEMD_MARKER_MASKED" == 1 ]]; then
    session_log "Using the PRoot-only renamed backup for stale /run/systemd/seats"
    return 0
  fi
  local marker=/run/systemd/seats
  systemd_pid1_active && return 0
  if [[ -L "$marker" || -L "$systemd_marker_backup" ]]; then
    session_log "Refusing to move a symlinked Fedora-only systemd marker path"
    return 1
  fi
  if [[ -e "$systemd_marker_backup" && ! -e "$marker" ]]; then
    # The previous supervisor may have been interrupted before its EXIT trap
    # ran. Keep the exact guest marker hidden and let this invocation restore it
    # on a normal exit; never leave a stale backup permanently orphaned.
    systemd_marker_hidden=1
    export FEDORA_SYSTEMD_MARKER_HIDDEN=1
    session_log "Reusing the PRoot-only hidden systemd marker from an interrupted session"
    return 0
  fi
  [[ -e "$marker" ]] || return 0
  [[ ! -e "$systemd_marker_backup" ]] || return 0
  if mv -- "$marker" "$systemd_marker_backup" 2>/dev/null; then
    systemd_marker_hidden=1
    export FEDORA_SYSTEMD_MARKER_HIDDEN=1
    session_log "No systemd PID 1 in PRoot; hiding stale $marker so GNOME uses its dummy login manager"
  else
    session_log "Could not hide stale $marker; GNOME system-service probes may be unavailable"
  fi
}

wait_for_devkit_session() {
  local shell_pid="$1"
  local viewer_pid="$2"
  local shell_rc=0
  devkit_session_reason=shell
  devkit_shell_rc=0

  while :; do
    if linux_mode_stop_requested; then
      devkit_session_reason=stop
      session_log "Linux Mode stop requested; ending the Fedora Devkit session cleanly"
      kill "$shell_pid" 2>/dev/null || true
      kill "$viewer_pid" 2>/dev/null || true
      wait "$shell_pid" 2>/dev/null || true
      wait "$viewer_pid" 2>/dev/null || true
      return 0
    fi
    if ! process_is_live "$shell_pid"; then
      wait "$shell_pid" 2>/dev/null || shell_rc=$?
      devkit_shell_rc="$shell_rc"
      if process_is_live "$viewer_pid"; then
        kill "$viewer_pid" 2>/dev/null || true
        wait "$viewer_pid" 2>/dev/null || true
      fi
      (( shell_rc == 0 )) && return 0
      return 125
    fi
    if ! process_is_live "$viewer_pid"; then
      devkit_session_reason=viewer
      session_log "Mutter Devkit viewer exited while GNOME Shell was still running; stopping the matching Fedora Shell process"
      kill "$shell_pid" 2>/dev/null || true
      wait "$shell_pid" 2>/dev/null || shell_rc=$?
      devkit_shell_rc="$shell_rc"
      return 125
    fi
    sleep 0.5
  done
}

restore_stale_systemd_marker() {
  local marker=/run/systemd/seats
  (( systemd_marker_hidden )) || return 0
  if [[ -L "$marker" || -L "$systemd_marker_backup" ]]; then
    session_log "Refusing to restore a symlinked Fedora-only systemd marker path"
    return 0
  fi
  [[ -e "$systemd_marker_backup" ]] || return 0
  # Do not overwrite a marker created by a real service while this session ran.
  if [[ ! -e "$marker" ]]; then
    mv -- "$systemd_marker_backup" "$marker" 2>/dev/null || true
  fi
}
# A crashed compositor can leave its endpoint behind. This runtime directory
# is project-owned, and start.sh has already checked that no Fedora session is
# running, so removing only Wayland endpoints is safe and prevents a stale
# socket from being mistaken for the new desktop.
remove_stale_wayland_sockets() {
  local socket
  for socket in \
    "$FEDORA_SESSION_RUNTIME"/wayland-[0-9]* \
    "$FEDORA_SESSION_RUNTIME"/wayland-[0-9]*.lock; do
    [[ -S "$socket" || -f "$socket" ]] || continue
    rm -f -- "$socket"
  done
}
remove_stale_wayland_sockets

session_log() {
  printf '[fedora-session] %s\n' "$*" | tee -a "$FEDORA_SESSION_LOG" >&2
}

linux_mode_stop_requested() {
  [[ -n "$FEDORA_LINUX_MODE_STOP_REQUEST" ]] \
    && [[ -f "$FEDORA_LINUX_MODE_STOP_REQUEST" \
    && ! -L "$FEDORA_LINUX_MODE_STOP_REQUEST" ]]
}

session_die() {
  session_log "ERROR: $*"
  exit 1
}

atomic_session_write() {
  local destination="$1"
  local mode="${2:-600}"
  local parent temporary

  session_path_parents_safe "$destination" || return 1
  if [[ -L "$destination" || ( -e "$destination" && ! -f "$destination" ) ]]; then
    session_log "ERROR: refusing unsafe Fedora session file: $destination"
    return 1
  fi
  parent="${destination%/*}"
  [[ -n "$parent" ]] || parent="/"
  [[ -d "$parent" && ! -L "$parent" ]] || return 1
  temporary="$(mktemp "$parent/.fedora-session-write.XXXXXX")" || return 1
  if ! cat > "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  chmod "$mode" "$temporary" 2>/dev/null || true
  [[ ! -L "$destination" ]] || {
    rm -f -- "$temporary"
    session_log "ERROR: Fedora session file became a symlink: $destination"
    return 1
  }
  mv -f -- "$temporary" "$destination"
  [[ -f "$destination" && ! -L "$destination" ]] || return 1
  chmod "$mode" "$destination" 2>/dev/null || true
}

private_system_bus_process_alive() {
  local pid="$1"
  local process_name=""
  local command_line=""

  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  process_is_live "$pid" || return 1
  [[ -r "/proc/$pid/comm" && -r "/proc/$pid/cmdline" ]] || return 1
  process_name="$(<"/proc/$pid/comm")"
  [[ "$process_name" == dbus-daemon ]] || return 1
  command_line="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  [[ "$command_line" == *"--config-file=$system_bus_config_path"* ]]
}

private_system_bus_state_is_safe() {
  local path
  for path in "$system_bus_pid_file" "$system_bus_socket" "$system_bus_config_path"; do
    session_path_parents_safe "$path" || return 1
    [[ ! -L "$path" ]] || return 1
  done
  if [[ -e "$system_bus_pid_file" && ! -f "$system_bus_pid_file" ]] \
    || [[ -e "$system_bus_config_path" && ! -f "$system_bus_config_path" ]] \
    || [[ -e "$system_bus_socket" && ! -S "$system_bus_socket" ]]; then
    return 1
  fi
}

remove_stale_private_system_bus_state() {
  local old_pid=""
  local tries=0

  private_system_bus_state_is_safe || {
    session_log "ERROR: refusing unsafe Fedora-private system D-Bus state"
    return 1
  }
  if [[ -r "$system_bus_pid_file" ]]; then
    old_pid="$(sed -n '1p' "$system_bus_pid_file" 2>/dev/null || true)"
    if private_system_bus_process_alive "$old_pid"; then
      session_log "Stopping stale Fedora-private system D-Bus process $old_pid"
      kill "$old_pid" 2>/dev/null || true
      while private_system_bus_process_alive "$old_pid" && (( tries < 20 )); do
        sleep 0.1
        tries=$((tries + 1))
      done
      if private_system_bus_process_alive "$old_pid"; then
        # The PID was proved to be this project's dbus-daemon by both /proc
        # comm and its exact project-owned --config-file argument.
        kill -KILL "$old_pid" 2>/dev/null || true
      fi
    fi
  fi
  rm -f -- "$system_bus_pid_file" "$system_bus_socket" "$system_bus_config_path"
}

stop_private_system_bus() {
  local pid="$system_bus_pid"
  local tries=0

  if private_system_bus_process_alive "$pid"; then
    kill "$pid" 2>/dev/null || true
    while private_system_bus_process_alive "$pid" && (( tries < 20 )); do
      sleep 0.1
      tries=$((tries + 1))
    done
    if private_system_bus_process_alive "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    wait "$pid" 2>/dev/null || true
  fi
  system_bus_pid=""
  if [[ "${DBUS_SYSTEM_BUS_ADDRESS:-}" == "$system_bus_address" ]]; then
    unset DBUS_SYSTEM_BUS_ADDRESS
  fi
  rm -f -- "$system_bus_pid_file" "$system_bus_socket" "$system_bus_config_path"
}

start_private_system_bus() {
  case "$FEDORA_SYSTEM_BUS_MODE" in
    private|auto)
      ;;
    *)
      session_log "ERROR: FEDORA_SYSTEM_BUS_MODE=$FEDORA_SYSTEM_BUS_MODE is unsupported; PRoot GNOME requires the Fedora-private compatibility bus"
      return 1
      ;;
  esac

  command -v dbus-daemon >/dev/null 2>&1 || {
    session_log "ERROR: dbus-daemon is missing; cannot provide Fedora-private system D-Bus compatibility"
    return 1
  }
  private_system_bus_state_is_safe || {
    session_log "ERROR: refusing unsafe Fedora-private system D-Bus state"
    return 1
  }
  remove_stale_private_system_bus_state || return 1

  local escaped_socket_path
  escaped_socket_path="$(printf '%s' "$system_bus_socket" \
    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
  if ! atomic_session_write "$system_bus_config_path" 600 <<EOF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <keep_umask/>
  <listen>unix:path=$escaped_socket_path</listen>
  <auth>EXTERNAL</auth>
  <!-- No standard_session_servicedirs/servicedir/include on purpose. This
       endpoint only makes Gio.DBus.system connectable; it does not provide
       logind, PolicyKit, UPower, GDM, RTKit or any other privileged service. -->
  <policy context="default">
    <allow user="*"/>
    <allow send_destination="*"/>
    <allow send_type="method_call"/>
    <allow send_type="signal"/>
    <allow send_requested_reply="true"/>
    <allow receive_type="method_call"/>
    <allow receive_type="method_return"/>
    <allow receive_type="error"/>
    <allow receive_type="signal"/>
    <allow own="*"/>
  </policy>
</busconfig>
EOF
  then
    return 1
  fi

  system_bus_address="unix:path=$system_bus_socket"
  dbus-daemon --config-file="$system_bus_config_path" --nofork --nopidfile \
    >> "$FEDORA_SESSION_LOG" 2>&1 &
  system_bus_pid="$!"
  child_pids+=("$system_bus_pid")
  if ! atomic_session_write "$system_bus_pid_file" 600 <<< "$system_bus_pid"; then
    session_log "ERROR: could not record the Fedora-private system D-Bus PID safely"
    return 1
  fi

  local tries=0
  while (( tries < 50 )); do
    if private_system_bus_process_alive "$system_bus_pid" \
      && [[ -S "$system_bus_socket" && ! -L "$system_bus_socket" ]]; then
      export DBUS_SYSTEM_BUS_ADDRESS="$system_bus_address"
      session_log "Fedora-private system D-Bus compatibility bus is ready: $system_bus_address (no privileged service activation)"
      return 0
    fi
    if ! process_is_live "$system_bus_pid"; then
      session_log "ERROR: Fedora-private system D-Bus exited before becoming ready"
      return 1
    fi
    sleep 0.1
    tries=$((tries + 1))
  done
  session_log "ERROR: Fedora-private system D-Bus did not become ready within 5 seconds"
  return 1
}

configure_memory_profile() {
  [[ "$FEDORA_MEMORY_PROFILE" == low ]] || return 0

  # Apply these before dbus-run-session so D-Bus-activated GNOME helpers inherit
  # the same allocator policy as the shell and supervisor-launched processes.
  # These are RSS/fragmentation guards, not a hard process memory limit or an
  # Android kernel control.
  export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"
  export MALLOC_TRIM_THRESHOLD_="${MALLOC_TRIM_THRESHOLD_:-131072}"

  # The tablet's Android panel is not changed. This only selects the virtual
  # monitor used by nested Mutter, reducing compositor/Xwayland buffers while
  # keeping the panel's aspect ratio. An explicit mode spec always wins.
  if [[ -z "${FEDORA_NESTED_MODE_SPECS:-}" ]]; then
    FEDORA_NESTED_MODE_SPECS=1920x1200
    export FEDORA_NESTED_MODE_SPECS
    session_log "Low-memory profile uses a 1920x1200 virtual monitor; set FEDORA_NESTED_MODE_SPECS to override"
  fi
}

configure_keyboard_mode() {
  # Never trust a host-supplied XKB path; only the canonical Fedora catalog
  # may be exposed to the Linux session.
  unset XKB_CONFIG_ROOT || true
  case "$FEDORA_KEYBOARD_MODE" in
    linux|focused|auto)
      export FEDORA_KEYBOARD_MODE
      # XKB_CONFIG_ROOT is a Fedora guest path only. Set the canonical path
      # when it exists, without accepting a caller-supplied symlink or path.
      if [[ -d /usr/share/X11/xkb && ! -L /usr/share/X11/xkb ]]; then
        export XKB_CONFIG_ROOT=/usr/share/X11/xkb
        session_log "Linux keyboard focus mode enabled: ordinary keys follow the focused Termux:X11/Fedora surface; XKB_CONFIG_ROOT=$XKB_CONFIG_ROOT"
      else
        session_log "Linux keyboard focus mode enabled: ordinary keys follow the focused Termux:X11/Fedora surface; guest XKB catalog unavailable"
      fi
      ;;
    *)
      session_log "Unknown FEDORA_KEYBOARD_MODE=$FEDORA_KEYBOARD_MODE; using Linux focused-input mode"
      FEDORA_KEYBOARD_MODE=linux
      export FEDORA_KEYBOARD_MODE
      ;;
  esac
}
configure_keyboard_mode
configure_memory_profile

backup_fedora_settings() {
  command -v gsettings >/dev/null 2>&1 || return 0
  if [[ -e "$local_settings_backup" ]]; then
    [[ -f "$local_settings_backup" && ! -L "$local_settings_backup" ]] || \
      session_die "Fedora-local settings backup is unsafe: $local_settings_backup"
    return 0
  fi

  local temporary schema key value setting saved=0
  temporary="$(mktemp "$FEDORA_SESSION_RUNTIME/.fedora-settings.XXXXXX")" || \
    session_die "Could not create Fedora-local settings backup"
  chmod 600 "$temporary" 2>/dev/null || true
  for setting in \
    'org.freedesktop.Tracker3.Miner.Files|enable-monitors' \
    'org.freedesktop.Tracker3.Miner.Files|crawling-interval' \
    'org.gnome.desktop.search-providers|disable-external' \
    'org.gnome.desktop.screen-time-limits|history-enabled' \
    'org.gnome.desktop.screen-time-limits|daily-limit-enabled'; do
    schema="${setting%%|*}"
    key="${setting#*|}"
    value="$(gsettings get "$schema" "$key" 2>/dev/null || true)"
    [[ -n "$value" ]] || continue
    printf '%s|%s|%s\n' "$schema" "$key" "$value" >> "$temporary"
    saved=$((saved + 1))
  done
  if (( saved > 0 )); then
    [[ ! -L "$local_settings_backup" ]] || {
      rm -f -- "$temporary"
      session_die "Fedora-local settings backup became a symlink"
    }
    mv -f -- "$temporary" "$local_settings_backup"
    chmod 600 "$local_settings_backup" 2>/dev/null || true
    session_log "Saved $saved Fedora-local dconf values for reversible session tuning"
  else
    rm -f -- "$temporary"
  fi
}

restore_fedora_settings() {
  if [[ -L "$local_settings_backup" \
    || ( -e "$local_settings_backup" && ! -f "$local_settings_backup" ) ]]; then
    session_log "ERROR: refusing unsafe Fedora-local settings backup: $local_settings_backup"
    return 0
  fi
  [[ -r "$local_settings_backup" ]] || return 0
  command -v gsettings >/dev/null 2>&1 || return 0

  local schema key value restored=1
  while IFS='|' read -r schema key value; do
    [[ -n "$schema" && -n "$key" && -n "$value" ]] || continue
    if ! gsettings set "$schema" "$key" "$value" \
      >> "$FEDORA_SESSION_LOG" 2>&1; then
      restored=0
    fi
  done < "$local_settings_backup"
  if (( restored )); then
    rm -f -- "$local_settings_backup"
    session_log "Restored Fedora-local dconf values; Android settings were not touched"
  else
    session_log "Could not restore every Fedora-local dconf value; backup retained for the next session"
  fi
}

portal_fuse_available() {
  [[ -c /dev/fuse ]] || return 1
  # Android may expose the device node while SELinux still denies opening it.
  (exec 3<>/dev/fuse) 2>/dev/null
}

calendar_services_disabled() {
  case "$FEDORA_CALENDAR_MODE" in
    off|disabled|none) return 0 ;;
    on|enabled) return 1 ;;
    auto) [[ "$FEDORA_MEMORY_PROFILE" == low ]] ;;
    *) return 1 ;;
  esac
}

portals_disabled_for_bus() {
  case "$FEDORA_PORTAL_MODE" in
    off|disabled|none|0|false|no) return 0 ;;
    on|enabled|1|true|yes) return 1 ;;
    auto) ! portal_fuse_available ;;
    *) return 0 ;;
  esac
}

session_bus_overrides_needed() {
  # Portal suppression is client-side plus a filtered activation catalog. Do
  # not register fake portal services: Mutter/GNOME legitimately probe portal
  # APIs and a /usr/bin/false service changes a harmless ServiceUnknown into
  # repeated activation failures. The filtered catalog is needed because the
  # stock D-Bus catalog can autostart xdg-desktop-portal even when GTK clients
  # were told not to use it.
  portals_disabled_for_bus || calendar_services_disabled
}

service_is_suppressed() {
  local service_file="$1"
  local service_name=""
  local service_basename="${service_file##*/}"

  # A service file's declared Name is authoritative, but the well-known
  # portal filenames are also a useful fail-closed guard. Some vendor files
  # have historically omitted/varied the key formatting while still naming
  # the portal service unambiguously. Never let a disabled portal return to
  # the private bus because a parser missed one spelling variant.
  case "$service_basename" in
    org.freedesktop.portal.*.service|org.freedesktop.impl.portal.*.service)
      portals_disabled_for_bus
      return
      ;;
    org.gnome.Shell.CalendarServer.service|org.gnome.OnlineAccounts.service|\
    org.gnome.Identity.service|org.gnome.evolution.dataserver.Sources5.service|\
    org.gnome.evolution.dataserver.Calendar8.service|\
    org.gnome.evolution.dataserver.AddressBook10.service)
      calendar_services_disabled
      return
      ;;
  esac

  # Fedora service files are not required to use the exact `Name=` spelling:
  # whitespace around the key/equal sign is legal. A strict match silently
  # reintroduced the very optional services this filter was meant to omit.
  service_name="$(sed -nE 's/^[[:space:]]*Name[[:space:]]*=[[:space:]]*([^[:space:]]+).*/\1/p' \
    "$service_file" 2>/dev/null | sed -n '1p' || true)"
  if [[ -z "$service_name" ]]; then
    service_name="${service_file##*/}"
    service_name="${service_name%.service}"
  fi
  case "$service_name" in
    org.freedesktop.portal.*|org.freedesktop.impl.portal.*)
      portals_disabled_for_bus
      return
      ;;
    org.gnome.Shell.CalendarServer|org.gnome.OnlineAccounts|org.gnome.Identity|\
    org.gnome.evolution.dataserver.Sources5|org.gnome.evolution.dataserver.Calendar8|\
    org.gnome.evolution.dataserver.AddressBook10)
      calendar_services_disabled
      return
      ;;
  esac
  return 1
}

build_filtered_dbus_service_dir() {
  local service_dir="$1"
  local service_file service_basename data_dir
  local copied=0 suppressed=0
  local -a suppressed_names=()
  local -a standard_service_dirs=()
  local -a data_dirs=()

  if ! session_path_parents_safe "$service_dir" \
    || [[ "$service_dir" != "$FEDORA_SESSION_RUNTIME/dbus-services" ]]; then
    session_log "Refusing an unexpected private D-Bus service directory: $service_dir"
    return 1
  fi
  if [[ -L "$service_dir" \
    || ( -e "$service_dir" && ! -d "$service_dir" ) ]]; then
    session_log "Refusing an unsafe private D-Bus service directory: $service_dir"
    return 1
  fi
  if [[ -d "$service_dir" ]]; then
    # This directory is generated by this supervisor. Remove only its direct
    # regular-file/symlink entries; preserve unknown directories and special
    # files by failing closed instead of recursively deleting user data.
    while IFS= read -r -d '' service_file; do
      if [[ ! -f "$service_file" && ! -L "$service_file" ]]; then
        session_log "Refusing unexpected entry in private D-Bus service directory: $service_file"
        return 1
      fi
      rm -f -- "$service_file"
    done < <(find "$service_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null || true)
  else
    mkdir -p "$service_dir"
  fi
  [[ -d "$service_dir" && ! -L "$service_dir" ]] || {
    session_log "Private D-Bus service directory became unavailable: $service_dir"
    return 1
  }

  # Mirror the standard session-service search locations into a project-owned
  # directory, omitting only services that are unavailable or intentionally
  # disabled in this Fedora/PRoot session. Symlinks keep the runtime small and
  # leave the package-owned service files untouched.
  standard_service_dirs+=("$FEDORA_SESSION_RUNTIME/dbus-1/services")
  if [[ -n "${XDG_DATA_HOME:-}" ]]; then
    data_dirs+=("$XDG_DATA_HOME")
  else
    data_dirs+=("${HOME:-/root}/.local/share")
  fi
  IFS=: read -r -a xdg_data_dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  data_dirs+=("${xdg_data_dirs[@]}")
  data_dirs+=(/usr/share)

  for data_dir in "${data_dirs[@]}"; do
    [[ -n "$data_dir" ]] || continue
    standard_service_dirs+=("$data_dir/dbus-1/services")
  done

  for data_dir in "${standard_service_dirs[@]}"; do
    [[ -d "$data_dir" ]] || continue
    while IFS= read -r -d '' service_file; do
      service_basename="${service_file##*/}"
      if service_is_suppressed "$service_file"; then
        suppressed=$((suppressed + 1))
        suppressed_names+=("$service_basename")
        continue
      fi
      [[ -e "$service_dir/$service_basename" ]] && continue
      ln -s -- "$service_file" "$service_dir/$service_basename" 2>/dev/null \
        || cp -L -- "$service_file" "$service_dir/$service_basename"
      copied=$((copied + 1))
    done < <(find "$data_dir" -maxdepth 1 -type f -name '*.service' -print0 2>/dev/null || true)
  done

  # Re-check the copied catalog by its declared bus name as well as by its
  # filename. This protects against vendor service files whose filename does
  # not match the well-known name and keeps the generated directory truly
  # fail-closed when portals/calendar helpers are disabled.
  for service_file in "$service_dir"/*.service; do
    [[ -e "$service_file" ]] || continue
    if service_is_suppressed "$service_file"; then
      service_basename="${service_file##*/}"
      rm -f -- "$service_file"
      suppressed=$((suppressed + 1))
      suppressed_names+=("$service_basename")
    fi
  done

  if (( suppressed > 0 )); then
    session_log "Private D-Bus catalog: suppressed $suppressed optional service entries; copied $copied entries"
    session_log "Suppressed service files: ${suppressed_names[*]}"
  else
    session_log "Private D-Bus catalog: no optional service entries matched; copied $copied entries"
  fi
}

make_no_portal_dbus_config() {
  local config_path="$FEDORA_SESSION_RUNTIME/dbus-session-no-portals.conf"
  local service_dir="$FEDORA_SESSION_RUNTIME/dbus-services"
  local escaped_service_dir

  # GTK_USE_PORTAL/GIO_USE_VFS stop normal client-side portal selection. The
  # filtered catalog additionally keeps portal and low-memory helper names out
  # of the private bus, so optional probes return ServiceUnknown and do not
  # launch xdg-desktop-portal, Evolution or GOA. Do not include Fedora's
  # package-owned session.conf here: its nested /etc includes can re-add the
  # standard service directories after this function has filtered them.
  # Do not add a broad D-Bus deny policy: it turns optional lookups into
  # AccessDenied and makes Mutter/GDK noisier than a normal missing service.
  # The generated config intentionally replaces the stock
  # <standard_session_servicedirs /> expansion with one filtered directory.
  build_filtered_dbus_service_dir "$service_dir"
  chmod 700 "$service_dir" 2>/dev/null || true

  escaped_service_dir="$(printf '%s' "$service_dir" \
    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
  if ! atomic_session_write "$config_path" 600 <<EOF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <keep_umask/>
  <listen>unix:tmpdir=/tmp</listen>
  <auth>EXTERNAL</auth>
  <servicedir>$escaped_service_dir</servicedir>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
</busconfig>
EOF
  then
    rm -f -- "$config_path"
    return 1
  fi
  printf '%s\n' "$config_path"
}

# dbus-run-session supplies the session bus and removes it when the compositor
# exits. Re-exec keeps the inside-bus path easy to inspect in logs.
if [[ "${1:-}" != --inside-dbus ]]; then
  command -v dbus-run-session >/dev/null 2>&1 || session_die "dbus-run-session is missing"
  case "$FEDORA_SYSTEM_BUS_MODE" in
    private|auto)
      # Never inherit a caller/host system-bus address. In this project the
      # only supported system-bus endpoint is created inside Fedora/PRoot.
      unset DBUS_SYSTEM_BUS_ADDRESS
      ;;
    *)
      session_die "FEDORA_SYSTEM_BUS_MODE=$FEDORA_SYSTEM_BUS_MODE is unsupported; use private"
      ;;
  esac
  export XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME"
  dbus_args=()
  if session_bus_overrides_needed; then
    if dbus_config_path="$(make_no_portal_dbus_config || true)" && [[ -n "$dbus_config_path" ]]; then
      dbus_args+=("--config-file=$dbus_config_path")
      session_log "Using filtered private D-Bus activation catalog: $dbus_config_path"
    else
      session_log "Could not build the optional-service D-Bus overrides; client-side guards remain active"
    fi
  fi
  if portals_disabled_for_bus; then
    # Set client-side guards before any D-Bus-activated GNOME helper can run.
    # The later start_desktop_portals() call repeats these assignments for the
    # normal in-session path; doing it here also covers early Shell probes.
    export GTK_USE_PORTAL="${GTK_USE_PORTAL:-0}"
    export GIO_USE_VFS="${GIO_USE_VFS:-local}"
    export ADW_DISABLE_PORTAL="${ADW_DISABLE_PORTAL:-1}"
  fi
  exec dbus-run-session "${dbus_args[@]}" -- "$0" --inside-dbus "$@"
fi
shift

# Do not alias the private session bus to DBus.system. They have different
# security contracts. A project-owned compatibility bus is started below so
# GNOME 50's unconditional Gio.DBus.system connection can succeed without
# exposing Android's bus or pretending to provide privileged services.
unset DBUS_SYSTEM_BUS_ADDRESS

