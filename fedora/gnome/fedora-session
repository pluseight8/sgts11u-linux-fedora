#!/usr/bin/env bash
set -Eeuo pipefail

# fedora-session: no-systemd GNOME supervisor for a PRoot guest.
# Marker used by start/stop and diagnostics: fedora-shell-session-v1

FEDORA_SESSION_LOG="${FEDORA_SESSION_LOG:-${XDG_RUNTIME_DIR:-/tmp}/fedora-session.log}"
FEDORA_SESSION_RUNTIME="${FEDORA_SESSION_RUNTIME:-/tmp/fedora-runtime}"
FEDORA_DISPLAY="${DISPLAY:-:0}"
FEDORA_NESTED_SCALE="${FEDORA_NESTED_SCALE:-1}"
FEDORA_NESTED_MODE="${FEDORA_NESTED_MODE:-auto}"
FEDORA_DEVKIT_GDK_BACKEND="${FEDORA_DEVKIT_GDK_BACKEND:-x11}"
FEDORA_DEVKIT_PIPEWIRE="${FEDORA_DEVKIT_PIPEWIRE:-auto}"
FEDORA_ALLOW_X11="${FEDORA_ALLOW_X11:-0}"
FEDORA_PORTAL_MODE="${FEDORA_PORTAL_MODE:-auto}"
FEDORA_MEMORY_PROFILE="${FEDORA_MEMORY_PROFILE:-balanced}"
FEDORA_AUDIO_MODE="${FEDORA_AUDIO_MODE:-auto}"
FEDORA_SETTINGS_DAEMON="${FEDORA_SETTINGS_DAEMON:-auto}"
FEDORA_LAUNCH_TERMINAL="${FEDORA_LAUNCH_TERMINAL:-auto}"
FEDORA_KEYRING_MODE="${FEDORA_KEYRING_MODE:-auto}"
FEDORA_SEARCH_MODE="${FEDORA_SEARCH_MODE:-auto}"

mkdir -p "$FEDORA_SESSION_RUNTIME" "$(dirname -- "$FEDORA_SESSION_LOG")"
chmod 700 "$FEDORA_SESSION_RUNTIME" 2>/dev/null || true
touch "$FEDORA_SESSION_LOG"

# A crashed compositor can leave its endpoint behind. This runtime directory
# is project-owned, and start.sh has already checked that no Fedora session is
# running, so removing only Wayland endpoints is safe and prevents a stale
# socket from being mistaken for the new desktop.
remove_stale_wayland_sockets() {
  local socket
  for socket in \
    "$FEDORA_SESSION_RUNTIME"/wayland-[0-9]* \
    "$FEDORA_SESSION_RUNTIME"/wayland-[0-9]*.lock; do
    [[ -S "$socket" || -f "$socket" ]] || continue
    rm -f -- "$socket"
  done
}
remove_stale_wayland_sockets

session_log() {
  printf '[fedora-session] %s\n' "$*" | tee -a "$FEDORA_SESSION_LOG" >&2
}

session_die() {
  session_log "ERROR: $*"
  exit 1
}

configure_memory_profile() {
  [[ "$FEDORA_MEMORY_PROFILE" == low ]] || return 0

  # Apply these before dbus-run-session so D-Bus-activated GNOME helpers inherit
  # the same allocator policy as the shell and supervisor-launched processes.
  # These are RSS/fragmentation guards, not a hard process memory limit or an
  # Android kernel control.
  export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"
  export MALLOC_TRIM_THRESHOLD_="${MALLOC_TRIM_THRESHOLD_:-131072}"

  # The tablet's Android panel is not changed. This only selects the virtual
  # monitor used by nested Mutter, reducing compositor/Xwayland buffers while
  # keeping the panel's aspect ratio. An explicit mode spec always wins.
  if [[ -z "${FEDORA_NESTED_MODE_SPECS:-}" ]]; then
    FEDORA_NESTED_MODE_SPECS=2560x1600
    export FEDORA_NESTED_MODE_SPECS
    session_log "Low-memory profile uses a 2560x1600 virtual monitor; set FEDORA_NESTED_MODE_SPECS to override"
  fi
}
configure_memory_profile

portal_fuse_available() {
  [[ -c /dev/fuse ]] || return 1
  # Android may expose the device node while SELinux still denies opening it.
  (exec 3<>/dev/fuse) 2>/dev/null
}

portal_mode_disables_autostart() {
  case "$FEDORA_PORTAL_MODE" in
    off|disabled|none) return 0 ;;
    auto) ! portal_fuse_available ;;
    on|enabled) return 1 ;;
    *) return 0 ;;
  esac
}

make_no_portal_dbus_config() {
  local config_path="$FEDORA_SESSION_RUNTIME/dbus-session-no-portals.conf"
  local service_dir="$FEDORA_SESSION_RUNTIME/dbus-services"
  [[ -r /usr/share/dbus-1/session.conf ]] || return 1

  # GTK_USE_PORTAL/GIO_USE_VFS stop normal client-side portal selection, but
  # GNOME Shell and Mutter Devkit can still request portal names directly. Put
  # cheap project-owned failing service stubs before the standard service
  # directories. Do not add a broad D-Bus deny policy: it turns an optional
  # portal lookup into AccessDenied and makes Mutter/GDK noisier than the
  # normal ServiceUnknown/activation-failed result.
  mkdir -p "$service_dir"
  local service_name
  for service_name in \
    org.freedesktop.portal.Desktop \
    org.freedesktop.portal.Documents \
    org.freedesktop.impl.portal.PermissionStore \
    org.freedesktop.impl.portal.desktop.gnome \
    org.freedesktop.impl.portal.desktop.gtk; do
    {
      printf '[D-BUS Service]\n'
      printf 'Name=%s\n' "$service_name"
      printf 'Exec=/usr/bin/false\n'
    } > "$service_dir/$service_name.service"
  done
  chmod 700 "$service_dir" 2>/dev/null || true
  chmod 600 "$service_dir"/*.service 2>/dev/null || true

  awk -v service_dir="$service_dir" '
    /<busconfig>/ && !service_dir_added {
      print
      printf "  <servicedir>%s</servicedir>\n", service_dir
      service_dir_added=1
      next
    }
    { print }
  ' /usr/share/dbus-1/session.conf > "$config_path"
  chmod 600 "$config_path" 2>/dev/null || true
  printf '%s\n' "$config_path"
}

# dbus-run-session supplies the session bus and removes it when the compositor
# exits. Re-exec keeps the inside-bus path easy to inspect in logs.
if [[ "${1:-}" != --inside-dbus ]]; then
  command -v dbus-run-session >/dev/null 2>&1 || session_die "dbus-run-session is missing"
  export XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME"
  dbus_args=()
  if portal_mode_disables_autostart; then
    if dbus_config_path="$(make_no_portal_dbus_config || true)" && [[ -n "$dbus_config_path" ]]; then
      dbus_args+=("--config-file=$dbus_config_path")
    else
      session_log "Could not build the no-portal D-Bus policy; client-side portal guards remain active"
    fi
  fi
  exec dbus-run-session "${dbus_args[@]}" -- "$0" --inside-dbus "$@"
fi
shift

# GNOME 50+ creates a Gio.DBus.system proxy during Shell startup. A PRoot
# guest has no Android/systemd system bus, but it does have the private bus
# created above. Reuse that bus as a compatibility address unless the caller
# supplied a real system bus explicitly. This provides a D-Bus endpoint for
# user-session startup without pretending that logind, UPower or RTKit exist.
if [[ -z "${DBUS_SYSTEM_BUS_ADDRESS:-}" && -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
  export DBUS_SYSTEM_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS"
  session_log "No system D-Bus is available; using the private session bus as a GNOME compatibility endpoint"
fi

export DISPLAY="$FEDORA_DISPLAY"
export XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME"
# Keep every PipeWire client on the project-owned native endpoint. In a PRoot
# guest the host environment may contain a stale/foreign PIPEWIRE_REMOTE, and
# Mutter Devkit uses the normal native socket rather than the manager socket.
export PIPEWIRE_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME"
export PIPEWIRE_REMOTE="pipewire-0"
export PIPEWIRE_CORE="pipewire-0"
export XDG_CURRENT_DESKTOP="GNOME"
export XDG_SESSION_DESKTOP="gnome"
if [[ "$FEDORA_NESTED_MODE" == x11 ]]; then
  export XDG_SESSION_TYPE=x11
else
  export XDG_SESSION_TYPE=wayland
fi
export GNOME_SHELL_SESSION_MODE="${GNOME_SHELL_SESSION_MODE:-user}"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"

session_option_enabled() {
  local requested="$1"
  case "$requested" in
    on|enabled|1|true|yes) return 0 ;;
    off|disabled|none|0|false|no) return 1 ;;
    auto) [[ "$FEDORA_MEMORY_PROFILE" != low ]] ;;
    *) return 1 ;;
  esac
}

configure_search_mode() {
  local mode="$FEDORA_SEARCH_MODE"
  if [[ "$mode" == auto ]]; then
    if [[ "$FEDORA_MEMORY_PROFILE" == low ]]; then
      mode=off
    else
      session_log "GNOME search indexing left at the user's current setting"
      return 0
    fi
  fi
  case "$mode" in
    off|disabled|none)
      session_log "GNOME search indexing disabled for memory profile $FEDORA_MEMORY_PROFILE"
      if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.freedesktop.Tracker3.Miner.Files enable-monitors false \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
        gsettings set org.freedesktop.Tracker3.Miner.Files crawling-interval -2 \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
        gsettings set org.gnome.desktop.search-providers disable-external true \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
      fi
      if command -v tracker3 >/dev/null 2>&1; then
        tracker3 daemon --terminate >> "$FEDORA_SESSION_LOG" 2>&1 || true
      fi
      ;;
    on|enabled)
      session_log "GNOME search indexing explicitly enabled"
      if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.freedesktop.Tracker3.Miner.Files enable-monitors true \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
        gsettings set org.freedesktop.Tracker3.Miner.Files crawling-interval 15 \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
      fi
      ;;
    *)
      session_log "Unknown FEDORA_SEARCH_MODE=$FEDORA_SEARCH_MODE; leaving search indexing unchanged"
      ;;
  esac
}

session_log "Memory profile: $FEDORA_MEMORY_PROFILE; audio=$FEDORA_AUDIO_MODE settings=$FEDORA_SETTINGS_DAEMON terminal=$FEDORA_LAUNCH_TERMINAL keyring=$FEDORA_KEYRING_MODE search=$FEDORA_SEARCH_MODE"
configure_search_mode

child_pids=()
pipewire_pid=""
pipewire_pid_file="$FEDORA_SESSION_RUNTIME/pipewire.pid"

pipewire_process_alive() {
  local pid="$1"
  local process_name=""
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  if [[ -r "/proc/$pid/comm" ]]; then
    process_name="$(<"/proc/$pid/comm")"
    [[ "$process_name" == pipewire ]] || return 1
  fi
  return 0
}

remove_stale_pipewire_state() {
  local old_pid=""
  local tries=0
  if [[ -r "$pipewire_pid_file" ]]; then
    old_pid="$(sed -n '1p' "$pipewire_pid_file" 2>/dev/null || true)"
    if pipewire_process_alive "$old_pid"; then
      session_log "Stopping stale project PipeWire process $old_pid"
      kill "$old_pid" 2>/dev/null || true
      while pipewire_process_alive "$old_pid" && (( tries < 20 )); do
        sleep 0.1
        ((tries += 1))
      done
      if pipewire_process_alive "$old_pid"; then
        kill -KILL "$old_pid" 2>/dev/null || true
      fi
    fi
  fi
  rm -f -- "$pipewire_pid_file" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0.lock" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0-manager" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0-manager.lock"
}

cleanup() {
  local pid tries
  for pid in "${child_pids[@]:-}"; do
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      tries=0
      while kill -0 "$pid" 2>/dev/null && (( tries < 20 )); do
        sleep 0.1
        ((tries += 1))
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
      wait "$pid" 2>/dev/null || true
    fi
  done
  rm -f -- "$FEDORA_SESSION_RUNTIME/fedora-session-state.env" \
    "$pipewire_pid_file" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0.lock" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0-manager" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0-manager.lock"
}
trap cleanup EXIT INT TERM

start_optional() {
  local name="$1"
  shift
  local executable=""
  if executable="$(command -v "$name" 2>/dev/null)"; then
    :
  elif [[ -x "/usr/libexec/$name" ]]; then
    executable="/usr/libexec/$name"
  else
    session_log "optional process not installed: $name"
    return 0
  fi
  "$executable" "$@" >> "$FEDORA_SESSION_LOG" 2>&1 &
  local child_pid="$!"
  child_pids+=("$child_pid")
  if [[ "$name" == pipewire ]]; then
    pipewire_pid="$child_pid"
    printf '%s\n' "$child_pid" > "$pipewire_pid_file"
    chmod 600 "$pipewire_pid_file" 2>/dev/null || true
  fi
}

wayland_transport_requested() {
  case "$FEDORA_NESTED_MODE" in
    x11|mutter) return 1 ;;
    *) return 0 ;;
  esac
}

pipewire_socket_ready() {
  # Mutter Devkit calls pw_context_connect() on the normal native server, not
  # the manager endpoint. A manager socket alone is not a usable compositor
  # transport and was the source of a false "ready" result.
  [[ -S "$FEDORA_SESSION_RUNTIME/pipewire-0" ]]
}

start_minimal_pipewire_for_devkit() {
  wayland_transport_requested || return 0
  case "$FEDORA_DEVKIT_PIPEWIRE" in
    off|disabled|none|0|false|no)
      session_log "Mutter Devkit PipeWire transport disabled (FEDORA_DEVKIT_PIPEWIRE=$FEDORA_DEVKIT_PIPEWIRE); Wayland Devkit cannot start"
      return 1
      ;;
    auto|on|enabled|1|true|yes)
      session_log "Starting minimal PipeWire display transport; full audio helpers remain disabled"
      command -v pipewire >/dev/null 2>&1 || {
        session_log "PipeWire binary is missing; install pipewire in the Fedora container"
        return 1
      }
      command -v pw-cli >/dev/null 2>&1 || {
        session_log "PipeWire native client probe is missing; install pipewire-utils in the Fedora container"
        return 1
      }
      start_optional pipewire
      ;;
    *)
      session_log "Unknown FEDORA_DEVKIT_PIPEWIRE=$FEDORA_DEVKIT_PIPEWIRE; skipping minimal PipeWire display transport"
      return 1
      ;;
  esac
}

pipewire_client_probe() {
  command -v pw-cli >/dev/null 2>&1 || return 1
  local probe_log="$FEDORA_SESSION_RUNTIME/pipewire-probe.log"
  : > "$probe_log"
  if command -v timeout >/dev/null 2>&1; then
    timeout 4 env \
      XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME" \
      PIPEWIRE_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME" \
      PIPEWIRE_REMOTE="$PIPEWIRE_REMOTE" \
      pw-cli -r "$PIPEWIRE_REMOTE" info 0 > "$probe_log" 2>&1
  else
    env \
      XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME" \
      PIPEWIRE_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME" \
      PIPEWIRE_REMOTE="$PIPEWIRE_REMOTE" \
      pw-cli -r "$PIPEWIRE_REMOTE" info 0 > "$probe_log" 2>&1
  fi
}

wait_for_pipewire() {
  wayland_transport_requested || return 0
  case "$FEDORA_DEVKIT_PIPEWIRE" in
    off|disabled|none|0|false|no) return 1 ;;
  esac
  [[ -n "$pipewire_pid" ]] || return 1
  command -v pw-cli >/dev/null 2>&1 || {
    session_log "PipeWire native client probe is missing; install pipewire-utils in the Fedora container"
    return 1
  }
  local tries=0
  local probe_rc=0
  while (( tries < 50 )); do
    probe_rc=0
    if pipewire_socket_ready; then
      pipewire_client_probe || probe_rc=$?
      if (( probe_rc == 0 )); then
        session_log "PipeWire display transport is ready: $PIPEWIRE_RUNTIME_DIR/$PIPEWIRE_REMOTE"
        return 0
      fi
    fi
    if ! kill -0 "$pipewire_pid" 2>/dev/null; then
      session_log "PipeWire exited before accepting native clients; see $FEDORA_SESSION_RUNTIME/pipewire-probe.log"
      return 1
    fi
    sleep 0.1
    ((tries += 1))
  done
  session_log "PipeWire did not accept a native client within 5 seconds; see $FEDORA_SESSION_RUNTIME/pipewire-probe.log"
  return 1
}

# PipeWire and portals are user processes here. Mutter Devkit itself is a
# PipeWire screen-cast client, so a minimal PipeWire server is mandatory even
# when the user has disabled audio. The low-memory profile therefore omits
# WirePlumber and pipewire-pulse, but keeps this one small display transport.
start_audio_stack() {
  case "$FEDORA_AUDIO_MODE" in
    off|disabled|none)
      session_log "Audio stack disabled (FEDORA_AUDIO_MODE=$FEDORA_AUDIO_MODE)"
      start_minimal_pipewire_for_devkit
      ;;
    on|enabled)
      start_optional pipewire
      start_optional wireplumber
      start_optional pipewire-pulse
      ;;
    auto)
      if [[ "$FEDORA_MEMORY_PROFILE" == low ]]; then
        session_log "Full audio stack skipped by low memory profile; keeping minimal PipeWire for Mutter Devkit"
        start_minimal_pipewire_for_devkit
      else
        start_optional pipewire
        start_optional wireplumber
        start_optional pipewire-pulse
      fi
      ;;
    *)
      session_log "Unknown FEDORA_AUDIO_MODE=$FEDORA_AUDIO_MODE; audio stack disabled"
      start_minimal_pipewire_for_devkit
      ;;
  esac
  wait_for_pipewire
}
remove_stale_pipewire_state
if ! start_audio_stack; then
  session_die "PipeWire native display transport is unavailable; see $FEDORA_SESSION_RUNTIME/pipewire-probe.log and $FEDORA_SESSION_LOG"
fi

start_desktop_portals() {
  case "$FEDORA_PORTAL_MODE" in
    off|disabled|none)
      export GTK_USE_PORTAL="${GTK_USE_PORTAL:-0}"
      export GIO_USE_VFS="${GIO_USE_VFS:-local}"
      export ADW_DISABLE_PORTAL="${ADW_DISABLE_PORTAL:-1}"
      session_log "Desktop portals disabled (FEDORA_PORTAL_MODE=$FEDORA_PORTAL_MODE)"
      return 0
      ;;
    auto)
      if ! portal_fuse_available; then
        export GTK_USE_PORTAL="${GTK_USE_PORTAL:-0}"
        export GIO_USE_VFS="${GIO_USE_VFS:-local}"
        export ADW_DISABLE_PORTAL="${ADW_DISABLE_PORTAL:-1}"
        session_log "Skipping xdg-desktop-portal: /dev/fuse is unavailable under Android/PRoot"
        return 0
      fi
      ;;
    on|enabled)
      ;;
    *)
      export GTK_USE_PORTAL="${GTK_USE_PORTAL:-0}"
      export GIO_USE_VFS="${GIO_USE_VFS:-local}"
      export ADW_DISABLE_PORTAL="${ADW_DISABLE_PORTAL:-1}"
      session_log "Unknown FEDORA_PORTAL_MODE=$FEDORA_PORTAL_MODE; desktop portals disabled"
      return 0
      ;;
  esac
  start_optional xdg-desktop-portal
  start_optional xdg-desktop-portal-gtk
}

start_desktop_portals

if command -v gnome-keyring-daemon >/dev/null 2>&1; then
  keyring_components=""
  case "$FEDORA_KEYRING_MODE" in
    off|disabled|none)
      session_log "GNOME keyring disabled (FEDORA_KEYRING_MODE=$FEDORA_KEYRING_MODE)"
      ;;
    secrets)
      keyring_components=secrets
      ;;
    on|enabled|all)
      keyring_components=secrets,ssh
      ;;
    auto)
      if [[ "$FEDORA_MEMORY_PROFILE" == low ]]; then
        session_log "GNOME keyring skipped by low memory profile; set FEDORA_KEYRING_MODE=secrets or on to enable it"
      else
        keyring_components=secrets,ssh
      fi
      ;;
    *)
      session_log "Unknown FEDORA_KEYRING_MODE=$FEDORA_KEYRING_MODE; keyring disabled"
      ;;
  esac
  if [[ -n "$keyring_components" ]]; then
    keyring_env="$(gnome-keyring-daemon --start --components="$keyring_components" 2>/dev/null || true)"
  else
    keyring_env=""
  fi
  if [[ -n "$keyring_env" ]]; then
    # The command emits shell assignments from the trusted Fedora package.
    eval "$keyring_env"
  fi
fi

has_option() {
  local command_name="$1"
  local option="$2"
  "$command_name" --help 2>&1 | grep -Fq -- "$option"
}

report_process_exit() {
  local label="$1"
  local process_rc="$2"
  session_log "$label exited with status $process_rc."
  if (( process_rc >= 128 )); then
    session_log "Signal: $((process_rc - 128))"
  fi
  if (( process_rc == 134 )); then
    session_log "GNOME Shell reported SIGABRT; the captured tail below is the actionable crash context."
  fi
  session_log "Recent output from $FEDORA_SESSION_LOG:"
  tail -n 100 "$FEDORA_SESSION_LOG" >&2 || true
}

wait_for_nested_socket() {
  local before="$1"
  local process_pid="${2:-}"
  local tries=0
  local display_name=""
  local candidate
  while (( tries < 100 )); do
    if [[ -n "$process_pid" ]] && ! kill -0 "$process_pid" 2>/dev/null; then
      return 1
    fi
    display_name="$(grep -Eo 'wayland-[0-9]+' "$FEDORA_SESSION_LOG" | tail -n 1 || true)"
    if [[ -n "$display_name" && -S "$FEDORA_SESSION_RUNTIME/$display_name" ]] \
      && ! grep -Fxq "$display_name" <<< "$before"; then
      printf '%s\n' "$display_name"
      return 0
    fi
    for candidate in "$FEDORA_SESSION_RUNTIME"/wayland-*; do
      [[ -S "$candidate" ]] || continue
      display_name="${candidate##*/}"
      if ! grep -Fxq "$display_name" <<< "$before"; then
        printf '%s\n' "$display_name"
        return 0
      fi
    done
    sleep 0.1
    ((tries += 1))
  done
  return 1
}

process_ids_by_name() {
  local process_name="$1"
  local process_dir process_pid process_comm

  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x "$process_name" 2>/dev/null || true
    return 0
  fi
  # procps/pgrep is normally pulled in by Fedora GNOME, but keep the viewer
  # health check useful on a trimmed guest as well.
  for process_dir in /proc/[0-9]*; do
    [[ -r "$process_dir/comm" ]] || continue
    process_pid="${process_dir##*/}"
    process_comm="$(<"$process_dir/comm")" || continue
    [[ "$process_comm" == "$process_name" ]] || continue
    printf '%s\n' "$process_pid"
  done
}

new_process_pid() {
  local process_name="$1"
  local previous_pids="${2:-}"
  local process_pid

  while read -r process_pid; do
    [[ "$process_pid" =~ ^[0-9]+$ ]] || continue
    if ! grep -Fxq "$process_pid" <<< "$previous_pids"; then
      printf '%s\n' "$process_pid"
      return 0
    fi
  done < <(process_ids_by_name "$process_name")
  return 1
}

wait_for_devkit_viewer() {
  local previous_pids="$1"
  local shell_pid="$2"
  local tries=0
  local viewer_pid=""

  while (( tries < 100 )); do
    if ! kill -0 "$shell_pid" 2>/dev/null; then
      return 1
    fi
    viewer_pid="$(new_process_pid mutter-devkit "$previous_pids" || true)"
    if [[ "$viewer_pid" =~ ^[0-9]+$ ]] && kill -0 "$viewer_pid" 2>/dev/null; then
      printf '%s\n' "$viewer_pid"
      return 0
    fi
    sleep 0.1
    ((tries += 1))
  done
  return 1
}

mutter_devkit_path() {
  if [[ -x /usr/libexec/mutter-devkit ]]; then
    printf '%s\n' /usr/libexec/mutter-devkit
  elif command -v mutter-devkit >/dev/null 2>&1; then
    command -v mutter-devkit
  else
    return 1
  fi
}

launch_terminal() {
  local terminal
  if command -v ptyxis >/dev/null 2>&1; then
    terminal=ptyxis
  elif command -v gnome-console >/dev/null 2>&1; then
    terminal=gnome-console
  elif command -v gnome-terminal >/dev/null 2>&1; then
    terminal=gnome-terminal
  else
    session_log "No GNOME terminal package found; open applications from the shell overview."
    return 0
  fi
  "$terminal" >> "$FEDORA_SESSION_LOG" 2>&1 &
  child_pids+=("$!")
}

start_settings_daemon() {
  if ! session_option_enabled "$FEDORA_SETTINGS_DAEMON"; then
    session_log "gnome-settings-daemon skipped by memory profile $FEDORA_MEMORY_PROFILE; set FEDORA_SETTINGS_DAEMON=on to enable it"
    return 0
  fi
  if command -v gnome-settings-daemon >/dev/null 2>&1; then
    gnome-settings-daemon --replace >> "$FEDORA_SESSION_LOG" 2>&1 &
    child_pids+=("$!")
  else
    session_log "optional process not installed: gnome-settings-daemon"
  fi
}

start_session_terminal() {
  if session_option_enabled "$FEDORA_LAUNCH_TERMINAL"; then
    launch_terminal
  else
    session_log "Automatic GNOME terminal launch skipped by memory profile $FEDORA_MEMORY_PROFILE; open it from the overview or set FEDORA_LAUNCH_TERMINAL=on"
  fi
}

run_wayland_devkit() {
  has_option gnome-shell --devkit || return 1
  has_option gnome-shell --wayland || return 1

  local devkit_path
  devkit_path="$(mutter_devkit_path || true)"
  if [[ -z "$devkit_path" ]]; then
    session_log "GNOME Shell supports --devkit, but mutter-devkit is missing"
    return 1
  fi

  local before before_viewer shell_pid nested_display shell_rc killed
  local viewer_pid saved_gdk_backend saved_wayland_display
  local devkit_backend="$FEDORA_DEVKIT_GDK_BACKEND"
  before="$(find "$FEDORA_SESSION_RUNTIME" -maxdepth 1 -type s -name 'wayland-*' -exec basename {} \; 2>/dev/null || true)"
  before_viewer="$(process_ids_by_name mutter-devkit)"
  session_log "Starting GNOME Shell Wayland through Mutter Devkit on outer DISPLAY=$DISPLAY"
  local shell_args=(--wayland --devkit)
  if has_option gnome-shell --sm-disable; then
    shell_args+=(--sm-disable)
  fi
  if [[ "$FEDORA_NESTED_SCALE" != 1 ]]; then
    export MUTTER_DEBUG_DUMMY_MONITOR_SCALES="$FEDORA_NESTED_SCALE"
  fi
  if [[ -n "${FEDORA_NESTED_MODE_SPECS:-}" ]]; then
    export MUTTER_DEBUG_DUMMY_MODE_SPECS="$FEDORA_NESTED_MODE_SPECS"
  fi

  saved_gdk_backend="${GDK_BACKEND:-}"
  saved_wayland_display="${WAYLAND_DISPLAY:-}"
  case "$devkit_backend" in
    auto|x11)
      # Termux:X11 is the outer transport. Force only the Devkit GTK viewer to
      # use it; leaving the parent at wayland,x11 can make GTK choose the new
      # nested socket after Mutter publishes it, which is a self-connection.
      export GDK_BACKEND=x11
      unset WAYLAND_DISPLAY
      session_log "Mutter Devkit viewer backend: X11 ($DISPLAY)"
      ;;
    wayland)
      if [[ -z "$saved_wayland_display" ]]; then
        session_log "FEDORA_DEVKIT_GDK_BACKEND=wayland requested, but no outer WAYLAND_DISPLAY exists"
        return 1
      fi
      export GDK_BACKEND=wayland
      session_log "Mutter Devkit viewer backend: outer Wayland ($saved_wayland_display)"
      ;;
    *)
      session_log "Unknown FEDORA_DEVKIT_GDK_BACKEND=$FEDORA_DEVKIT_GDK_BACKEND; use auto, x11 or wayland"
      return 1
      ;;
  esac
  gnome-shell "${shell_args[@]}" >> "$FEDORA_SESSION_LOG" 2>&1 &
  shell_pid="$!"
  child_pids+=("$shell_pid")

  if ! nested_display="$(wait_for_nested_socket "$before" "$shell_pid")"; then
    session_log "GNOME Shell Devkit did not publish a Wayland socket (viewer: $devkit_path)"
    killed=0
    if kill -0 "$shell_pid" 2>/dev/null; then
      kill "$shell_pid" 2>/dev/null || true
      killed=1
    fi
    shell_rc=0
    wait "$shell_pid" 2>/dev/null || shell_rc=$?
    if (( ! killed && shell_rc != 0 )); then
      report_process_exit "GNOME Shell Devkit" "$shell_rc"
      return 125
    fi
    return 1
  fi
  if ! viewer_pid="$(wait_for_devkit_viewer "$before_viewer" "$shell_pid")"; then
    session_log "Mutter Devkit did not keep a GTK viewer alive; refusing to report a black/hidden session as ready"
    if kill -0 "$shell_pid" 2>/dev/null; then
      kill "$shell_pid" 2>/dev/null || true
    fi
    shell_rc=0
    wait "$shell_pid" 2>/dev/null || shell_rc=$?
    report_process_exit "GNOME Shell Devkit (viewer unavailable)" "$shell_rc"
    return 125
  fi
  child_pids+=("$viewer_pid")

  # The viewer was started by Mutter with the forced outer backend. Restore the
  # nested-client defaults in this supervisor before launching terminals or
  # settings helpers. The viewer keeps its own inherited environment.
  if [[ -n "$saved_gdk_backend" ]]; then
    export GDK_BACKEND="$saved_gdk_backend"
  else
    export GDK_BACKEND=wayland,x11
  fi
  if [[ -n "$saved_wayland_display" ]]; then
    export WAYLAND_DISPLAY="$saved_wayland_display"
  else
    unset WAYLAND_DISPLAY
  fi
  export WAYLAND_DISPLAY="$nested_display"
  export XDG_SESSION_TYPE=wayland
  {
    printf 'WAYLAND_DISPLAY=%q\n' "$WAYLAND_DISPLAY"
    printf 'XDG_RUNTIME_DIR=%q\n' "$XDG_RUNTIME_DIR"
    printf 'XDG_SESSION_TYPE=%q\n' "$XDG_SESSION_TYPE"
    printf 'DISPLAY=%q\n' "$DISPLAY"
  } > "$FEDORA_SESSION_RUNTIME/fedora-session-state.env"
  chmod 600 "$FEDORA_SESSION_RUNTIME/fedora-session-state.env" 2>/dev/null || true
  session_log "Mutter Devkit viewer is alive (PID $viewer_pid)"
  session_log "Desktop session: Wayland ($WAYLAND_DISPLAY) via Mutter Devkit; transport: X11 ($DISPLAY)"

  start_settings_daemon
  start_session_terminal
  shell_rc=0
  wait "$shell_pid" || shell_rc=$?
  if (( shell_rc != 0 )); then
    report_process_exit "GNOME Shell Devkit" "$shell_rc"
    return 125
  fi
  return 0
}

run_wayland_nested() {
  has_option gnome-shell --nested || return 1
  has_option gnome-shell --wayland || return 1

  local before shell_pid nested_display shell_rc killed
  before="$(find "$FEDORA_SESSION_RUNTIME" -maxdepth 1 -type s -name 'wayland-*' -exec basename {} \; 2>/dev/null || true)"
  session_log "Starting GNOME Shell nested Wayland on outer DISPLAY=$DISPLAY"
  local shell_args=(--nested --wayland)
  if has_option gnome-shell --sm-disable; then
    shell_args+=(--sm-disable)
  fi
  if [[ "$FEDORA_NESTED_SCALE" != 1 ]]; then
    export MUTTER_DEBUG_DUMMY_MONITOR_SCALES="$FEDORA_NESTED_SCALE"
  fi
  if [[ -n "${FEDORA_NESTED_MODE_SPECS:-}" ]]; then
    export MUTTER_DEBUG_DUMMY_MODE_SPECS="$FEDORA_NESTED_MODE_SPECS"
  fi

  unset WAYLAND_DISPLAY
  gnome-shell "${shell_args[@]}" >> "$FEDORA_SESSION_LOG" 2>&1 &
  shell_pid="$!"
  child_pids+=("$shell_pid")

  if ! nested_display="$(wait_for_nested_socket "$before" "$shell_pid")"; then
    session_log "GNOME Shell did not publish a nested Wayland socket"
    killed=0
    if kill -0 "$shell_pid" 2>/dev/null; then
      kill "$shell_pid" 2>/dev/null || true
      killed=1
    fi
    shell_rc=0
    wait "$shell_pid" 2>/dev/null || shell_rc=$?
    if (( ! killed && shell_rc != 0 )); then
      report_process_exit "GNOME Shell nested Wayland" "$shell_rc"
      return 125
    fi
    return 1
  fi
  export WAYLAND_DISPLAY="$nested_display"
  export XDG_SESSION_TYPE=wayland
  {
    printf 'WAYLAND_DISPLAY=%q\n' "$WAYLAND_DISPLAY"
    printf 'XDG_RUNTIME_DIR=%q\n' "$XDG_RUNTIME_DIR"
    printf 'XDG_SESSION_TYPE=%q\n' "$XDG_SESSION_TYPE"
    printf 'DISPLAY=%q\n' "$DISPLAY"
  } > "$FEDORA_SESSION_RUNTIME/fedora-session-state.env"
  chmod 600 "$FEDORA_SESSION_RUNTIME/fedora-session-state.env" 2>/dev/null || true
  session_log "Desktop session: Wayland ($WAYLAND_DISPLAY); transport: X11 ($DISPLAY)"

  start_settings_daemon
  start_session_terminal
  shell_rc=0
  wait "$shell_pid" || shell_rc=$?
  if (( shell_rc != 0 )); then
    report_process_exit "GNOME Shell nested Wayland" "$shell_rc"
    return 125
  fi
  return 0
}

run_x11_fallback() {
  fedora_is_true "$FEDORA_ALLOW_X11" || return 1
  has_option gnome-shell --x11 || return 1
  export XDG_SESSION_TYPE=x11
  unset WAYLAND_DISPLAY
  session_log "WARNING: explicit temporary GNOME X11 fallback enabled"
  local shell_args=(--x11)
  if has_option gnome-shell --sm-disable; then
    shell_args+=(--sm-disable)
  fi
  gnome-shell "${shell_args[@]}" >> "$FEDORA_SESSION_LOG" 2>&1 &
  local shell_pid="$!"
  child_pids+=("$shell_pid")
  local shell_rc=0
  wait "$shell_pid" || shell_rc=$?
  if (( shell_rc != 0 )); then
    report_process_exit "GNOME Shell X11 fallback" "$shell_rc"
    return 125
  fi
  return 0
}

fedora_is_true() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

case "$FEDORA_NESTED_MODE" in
  wayland|auto)
    if run_wayland_devkit; then
      exit 0
    else
      devkit_rc=$?
    fi
    if (( devkit_rc == 125 )); then
      session_die "GNOME Shell Devkit crashed; see $FEDORA_SESSION_LOG"
    fi
    if run_wayland_nested; then
      exit 0
    else
      nested_rc=$?
    fi
    if (( nested_rc == 125 )); then
      session_die "GNOME Shell nested Wayland crashed; see $FEDORA_SESSION_LOG"
    fi
    if [[ "$FEDORA_NESTED_MODE" == wayland ]]; then
      session_die "GNOME nested Wayland is unavailable; refusing silent X11 fallback"
    fi
    session_log "Mutter-only nested transport is not a GNOME desktop; refusing to report it as a successful session"
    ;;
  mutter)
    session_die "FEDORA_NESTED_MODE=mutter is transport-only and cannot provide GNOME Shell; use wayland or auto"
    ;;
  x11)
    if run_x11_fallback; then
      exit 0
    else
      x11_rc=$?
    fi
    if (( x11_rc == 125 )); then
      session_die "GNOME Shell X11 fallback crashed; see $FEDORA_SESSION_LOG"
    fi
    session_die "explicit X11 fallback requested but unavailable"
    exit 0
    ;;
  *)
    session_die "Unknown FEDORA_NESTED_MODE=$FEDORA_NESTED_MODE"
    ;;
esac

if run_x11_fallback; then
  exit 0
else
  x11_rc=$?
fi
if (( x11_rc == 125 )); then
  session_die "GNOME Shell X11 fallback crashed; see $FEDORA_SESSION_LOG"
fi

session_die "No supported GNOME display mode found. GNOME 49+ needs --devkit and mutter-devkit; see $FEDORA_SESSION_LOG"
