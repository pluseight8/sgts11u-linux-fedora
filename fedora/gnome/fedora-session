has_option() {
  local command_name="$1"
  local option="$2"
  "$command_name" --help 2>&1 | grep -Fq -- "$option"
}

report_process_exit() {
  local label="$1"
  local process_rc="$2"
  session_log "$label exited with status $process_rc."
  if (( process_rc >= 128 )); then
    session_log "Signal: $((process_rc - 128))"
  fi
  if (( process_rc == 134 )); then
    session_log "GNOME Shell reported SIGABRT; the captured tail below is the actionable crash context."
  fi
  session_log "Recent output from $FEDORA_SESSION_LOG:"
  tail -n 100 "$FEDORA_SESSION_LOG" >&2 || true
}

wait_for_nested_socket() {
  local before="$1"
  local process_pid="${2:-}"
  local tries=0
  local display_name=""
  local candidate
  while (( tries < 100 )); do
    if [[ -n "$process_pid" ]] && ! process_is_live "$process_pid"; then
      return 1
    fi
    display_name="$(grep -Eo 'wayland-[0-9]+' "$FEDORA_SESSION_LOG" | tail -n 1 || true)"
    if [[ -n "$display_name" \
      && -S "$FEDORA_SESSION_RUNTIME/$display_name" \
      && ! -L "$FEDORA_SESSION_RUNTIME/$display_name" ]] \
      && ! grep -Fxq "$display_name" <<< "$before"; then
      printf '%s\n' "$display_name"
      return 0
    fi
    for candidate in "$FEDORA_SESSION_RUNTIME"/wayland-*; do
      [[ -S "$candidate" && ! -L "$candidate" ]] || continue
      display_name="${candidate##*/}"
      if ! grep -Fxq "$display_name" <<< "$before"; then
        printf '%s\n' "$display_name"
        return 0
      fi
    done
    sleep 0.1
    ((tries += 1))
  done
  return 1
}

process_ids_by_name() {
  local process_name="$1"
  local process_dir process_pid process_comm process_command process_match
  local seen_pids=$'\n'

  if command -v pgrep >/dev/null 2>&1; then
    local pgrep_output=""
    pgrep_output="$(pgrep -x "$process_name" 2>/dev/null || true)"
    if [[ -n "$pgrep_output" ]]; then
      while read -r process_pid; do
        [[ "$process_pid" =~ ^[0-9]+$ ]] || continue
        case "$seen_pids" in
          *$'\n'"$process_pid"$'\n'*) continue ;;
        esac
        printf '%s\n' "$process_pid"
        seen_pids+="$process_pid"$'\n'
      done <<< "$pgrep_output"
    fi
  fi
  # procps/pgrep is normally pulled in by Fedora GNOME, but keep the viewer
  # health check useful on a trimmed guest as well. The Fedora integration
  # shim is a shell script at the exact /usr/libexec/mutter-devkit path, so its
  # /proc comm value is not guaranteed to remain `mutter-devkit` on every
  # kernel. Inspect only the command line for this one known Fedora binary;
  # never broaden this helper into a general process search.
  for process_dir in /proc/[0-9]*; do
    [[ -r "$process_dir/comm" ]] || continue
    process_pid="${process_dir##*/}"
    process_comm="$(<"$process_dir/comm")" || continue
    process_match=0
    if [[ "$process_comm" == "$process_name" ]]; then
      process_match=1
    elif [[ "$process_name" == mutter-devkit && -r "$process_dir/cmdline" ]]; then
      process_command="$(tr '\0' ' ' < "$process_dir/cmdline" 2>/dev/null || true)"
      case "$process_command" in
        */usr/libexec/mutter-devkit*|*mutter-devkit.real*) process_match=1 ;;
      esac
    fi
    (( process_match )) || continue
    case "$seen_pids" in
      *$'\n'"$process_pid"$'\n'*) continue ;;
    esac
    printf '%s\n' "$process_pid"
    seen_pids+="$process_pid"$'\n'
  done
}

report_devkit_evidence() {
  local viewer_pids="" viewer_pid environment
  viewer_pids="$(process_ids_by_name mutter-devkit || true)"
  session_log "Devkit failure evidence: mutter-devkit PIDs=${viewer_pids:-none}; Wayland sockets=$(find "$FEDORA_SESSION_RUNTIME" -maxdepth 1 -type s -name 'wayland-*' -exec basename {} \; 2>/dev/null | tr '\n' ' ' || true)"
  while read -r viewer_pid; do
    [[ "$viewer_pid" =~ ^[0-9]+$ ]] || continue
    if [[ -r "/proc/$viewer_pid/environ" ]]; then
      environment="$(tr '\0' '\n' < "/proc/$viewer_pid/environ" 2>/dev/null \
        | grep -E '^(DISPLAY|GDK_BACKEND|WAYLAND_DISPLAY|XDG_RUNTIME_DIR|PIPEWIRE_RUNTIME_DIR|PIPEWIRE_REMOTE|PIPEWIRE_CORE|DBUS_SYSTEM_BUS_ADDRESS)=' \
        | tr '\n' ' ' || true)"
    else
      environment=unavailable
    fi
    session_log "mutter-devkit[$viewer_pid] filtered environment: ${environment:-unavailable}"
  done <<< "$viewer_pids"
  if [[ -r "$FEDORA_SESSION_RUNTIME/pipewire-probe.log" ]]; then
    session_log "Recent PipeWire native probe output:"
    tail -n 30 "$FEDORA_SESSION_RUNTIME/pipewire-probe.log" >> "$FEDORA_SESSION_LOG" 2>/dev/null || true
  fi
}

new_process_pid() {
  local process_name="$1"
  local previous_pids="${2:-}"
  local process_pid

  while read -r process_pid; do
    [[ "$process_pid" =~ ^[0-9]+$ ]] || continue
    if ! grep -Fxq "$process_pid" <<< "$previous_pids"; then
      printf '%s\n' "$process_pid"
      return 0
    fi
  done < <(process_ids_by_name "$process_name")
  return 1
}

wait_for_stable_process() {
  local process_pid="$1"
  local checks="${2:-12}"
  local check=0

  [[ "$process_pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$checks" =~ ^[0-9]+$ ]] || return 64
  while (( check < checks )); do
    process_is_live "$process_pid" || return 1
    sleep 0.1
    check=$((check + 1))
  done
  process_is_live "$process_pid"
}

wait_for_devkit_viewer() {
  local previous_pids="$1"
  local shell_pid="$2"
  local max_tries="${3:-100}"
  local tries=0
  local viewer_pid=""

  while (( tries < max_tries )); do
    if ! process_is_live "$shell_pid"; then
      return 1
    fi
    viewer_pid="$(new_process_pid mutter-devkit "$previous_pids" || true)"
    if [[ "$viewer_pid" =~ ^[0-9]+$ ]] && wait_for_stable_process "$viewer_pid" 12; then
      printf '%s\n' "$viewer_pid"
      return 0
    fi
    sleep 0.1
    ((tries += 1))
  done
  return 1
}

mutter_devkit_path() {
  # GNOME's MetaMdk launcher uses MUTTER_LIBEXECDIR/mutter-devkit, and the
  # Fedora package installs that exact path. Do not accept an unrelated PATH
  # executable: the activation shim and the saved RPM binary must refer to
  # the same compositor component.
  if [[ -x /usr/libexec/mutter-devkit && ! -L /usr/libexec/mutter-devkit ]]; then
    printf '%s\n' /usr/libexec/mutter-devkit
  else
    return 1
  fi
}

launch_terminal() {
  local terminal
  if command -v ptyxis >/dev/null 2>&1; then
    terminal=ptyxis
  elif command -v gnome-console >/dev/null 2>&1; then
    terminal=gnome-console
  elif command -v gnome-terminal >/dev/null 2>&1; then
    terminal=gnome-terminal
  else
    session_log "No GNOME terminal package found; open applications from the shell overview."
    return 0
  fi
  "$terminal" >> "$FEDORA_SESSION_LOG" 2>&1 &
  child_pids+=("$!")
}

start_settings_daemon() {
  if ! session_option_enabled "$FEDORA_SETTINGS_DAEMON"; then
    session_log "gnome-settings-daemon skipped by memory profile $FEDORA_MEMORY_PROFILE; set FEDORA_SETTINGS_DAEMON=on to enable it"
    return 0
  fi
  if command -v gnome-settings-daemon >/dev/null 2>&1; then
    gnome-settings-daemon --replace >> "$FEDORA_SESSION_LOG" 2>&1 &
    child_pids+=("$!")
  else
    session_log "optional process not installed: gnome-settings-daemon"
  fi
}

start_session_terminal() {
  if session_option_enabled "$FEDORA_LAUNCH_TERMINAL"; then
    launch_terminal
  else
    session_log "Automatic GNOME terminal launch skipped by memory profile $FEDORA_MEMORY_PROFILE; open it from the overview or set FEDORA_LAUNCH_TERMINAL=on"
  fi
}

run_wayland_devkit() {
  has_option gnome-shell --devkit || return 1
  has_option gnome-shell --wayland || return 1

  local devkit_path
  devkit_path="$(mutter_devkit_path || true)"
  if [[ -z "$devkit_path" ]]; then
    session_log "GNOME Shell supports --devkit, but mutter-devkit is missing"
    return 1
  fi

  local before before_viewer shell_pid nested_display shell_rc killed
  local viewer_pid saved_wayland_display viewer_wait_tries
  local viewer_gdk_backend viewer_wayland_display
  local devkit_backend="$FEDORA_DEVKIT_GDK_BACKEND"
  local devkit_viewer_timeout="${FEDORA_DEVKIT_VIEWER_TIMEOUT:-15}"
  [[ "$devkit_viewer_timeout" =~ ^[1-9][0-9]?$ ]] || devkit_viewer_timeout=15
  viewer_wait_tries=$((devkit_viewer_timeout * 10))
  before="$(find "$FEDORA_SESSION_RUNTIME" -maxdepth 1 -type s -name 'wayland-*' -exec basename {} \; 2>/dev/null || true)"
  before_viewer="$(process_ids_by_name mutter-devkit)"
  session_log "Starting GNOME Shell Wayland through Mutter Devkit on outer DISPLAY=$DISPLAY"
  local shell_args=(--wayland --devkit)
  if ! nested_xwayland_enabled && has_option gnome-shell --no-x11; then
    shell_args+=(--no-x11)
    session_log "Inner Xwayland disabled for the nested compositor (outer Termux:X11 viewer remains enabled)"
  fi
  if has_option gnome-shell --sm-disable; then
    shell_args+=(--sm-disable)
  fi
  if [[ "$FEDORA_NESTED_SCALE" != 1 ]]; then
    export MUTTER_DEBUG_DUMMY_MONITOR_SCALES="$FEDORA_NESTED_SCALE"
  fi
  if [[ -n "${FEDORA_NESTED_MODE_SPECS:-}" ]]; then
    export MUTTER_DEBUG_DUMMY_MODE_SPECS="$FEDORA_NESTED_MODE_SPECS"
  fi

  saved_wayland_display="${WAYLAND_DISPLAY:-}"
  case "$devkit_backend" in
    auto|x11)
      # Termux:X11 is the outer transport. The GTK viewer needs X11, but the
      # GNOME Shell process itself must remain a Wayland client. Previously we
      # exported GDK_BACKEND=x11 here and Shell later attempted to initialize
      # its X11 services, which made a valid nested compositor look like a
      # compositor crash. Pass X11 only to the directly spawned GTK viewer and
      # to helper processes through the private activation environment.
      viewer_gdk_backend=x11
      viewer_wayland_display=""
      export FEDORA_DEVKIT_VIEWER_GDK_BACKEND="$viewer_gdk_backend"
      export GDK_BACKEND=wayland
      unset WAYLAND_DISPLAY
      session_log "Mutter Devkit viewer backend: X11 ($DISPLAY)"
      ;;
    wayland)
      if [[ -z "$saved_wayland_display" ]]; then
        session_log "FEDORA_DEVKIT_GDK_BACKEND=wayland requested, but no outer WAYLAND_DISPLAY exists"
        return 1
      fi
      viewer_gdk_backend=wayland
      viewer_wayland_display="$saved_wayland_display"
      export FEDORA_DEVKIT_VIEWER_GDK_BACKEND="$viewer_gdk_backend"
      export GDK_BACKEND=wayland
      export WAYLAND_DISPLAY="$saved_wayland_display"
      session_log "Mutter Devkit viewer backend: outer Wayland ($saved_wayland_display)"
      ;;
    *)
      session_log "Unknown FEDORA_DEVKIT_GDK_BACKEND=$FEDORA_DEVKIT_GDK_BACKEND; use auto, x11 or wayland"
      return 1
      ;;
  esac
  # MetaMdk starts mutter-devkit directly. The viewer receives its GDK backend
  # through the inherited FEDORA_DEVKIT_VIEWER_GDK_BACKEND variable consumed by
  # the Fedora-only shim; this is separate from GNOME Shell's GDK_BACKEND. The
  # private activation environment remains useful for GNOME helpers and
  # compatibility services.
  update_dbus_activation_environment "$viewer_gdk_backend" "$viewer_wayland_display"
  gnome-shell "${shell_args[@]}" >> "$FEDORA_SESSION_LOG" 2>&1 &
  shell_pid="$!"
  child_pids+=("$shell_pid")

  if ! nested_display="$(wait_for_nested_socket "$before" "$shell_pid")"; then
    session_log "GNOME Shell Devkit did not publish a Wayland socket (viewer: $devkit_path)"
    report_devkit_evidence
    killed=0
    if process_is_live "$shell_pid"; then
      kill "$shell_pid" 2>/dev/null || true
      killed=1
    fi
    shell_rc=0
    wait "$shell_pid" 2>/dev/null || shell_rc=$?
    if (( ! killed && shell_rc != 0 )); then
      report_process_exit "GNOME Shell Devkit" "$shell_rc"
      return 125
    fi
    return 1
  fi
  # MetaMdk starts the official GTK viewer directly. The Fedora-only shim at
  # /usr/libexec/mutter-devkit waits for the compositor-owned
  # org.gnome.Mutter.Devkit Env property before executing the RPM binary. A
  # standalone viewer cannot create that launch environment. If the viewer
  # cannot stay alive (for example while the outer Termux:X11 Activity is not
  # actually visible), report an ordinary transport failure so the dispatcher
  # can try the official nested Wayland compositor path below. Never report a
  # shell-only process as a ready desktop.
  viewer_pid="$(wait_for_devkit_viewer "$before_viewer" "$shell_pid" "$viewer_wait_tries" || true)"
  if [[ "$viewer_pid" =~ ^[0-9]+$ ]] && ! wait_for_stable_process "$viewer_pid" 8; then
    session_log "Mutter Devkit viewer disappeared during readiness (PID $viewer_pid)"
    viewer_pid=""
  fi
  if [[ ! "$viewer_pid" =~ ^[0-9]+$ ]] || ! process_is_live "$viewer_pid"; then
    session_log "Mutter Devkit did not keep the official GTK viewer alive; refusing to report a black/hidden session as ready"
    session_log "The compositor-owned viewer environment was unavailable; trying official nested Wayland as a bounded fallback"
    report_devkit_evidence
    if process_is_live "$shell_pid"; then
      kill "$shell_pid" 2>/dev/null || true
    fi
    shell_rc=0
    wait "$shell_pid" 2>/dev/null || shell_rc=$?
    report_process_exit "GNOME Shell Devkit (viewer unavailable)" "$shell_rc"
    return 1
  fi
  child_pids+=("$viewer_pid")

  # The viewer was started by Mutter with the forced outer backend. GNOME Shell
  # and every helper launched after readiness must use the nested Wayland
  # display; never restore a caller's possible GDK_BACKEND=x11 here. The
  # viewer keeps its own inherited X11 environment.
  export GDK_BACKEND=wayland,x11
  if [[ -n "$saved_wayland_display" ]]; then
    export WAYLAND_DISPLAY="$saved_wayland_display"
  else
    unset WAYLAND_DISPLAY
  fi
  export WAYLAND_DISPLAY="$nested_display"
  export XDG_SESSION_TYPE=wayland
  update_dbus_activation_environment
  if ! atomic_session_write "$FEDORA_SESSION_RUNTIME/fedora-session-state.env" 600 <<EOF
WAYLAND_DISPLAY=$(printf '%q' "$WAYLAND_DISPLAY")
XDG_RUNTIME_DIR=$(printf '%q' "$XDG_RUNTIME_DIR")
XDG_SESSION_TYPE=$(printf '%q' "$XDG_SESSION_TYPE")
DISPLAY=$(printf '%q' "$DISPLAY")
FEDORA_KEYBOARD_MODE=$(printf '%q' "$FEDORA_KEYBOARD_MODE")
EOF
  then
    session_log "ERROR: could not publish a safe Fedora Wayland session state"
    if process_is_live "$shell_pid"; then
      kill "$shell_pid" 2>/dev/null || true
    fi
    wait "$shell_pid" 2>/dev/null || true
    return 125
  fi
  session_log "Mutter Devkit viewer is alive (PID $viewer_pid)"
  session_log "Desktop session: Wayland ($WAYLAND_DISPLAY) via Mutter Devkit; transport: X11 ($DISPLAY)"

  start_settings_daemon
  start_session_terminal
  shell_rc=0
  wait_for_devkit_session "$shell_pid" "$viewer_pid" || shell_rc=$?
  if (( shell_rc != 0 )); then
    if [[ "$devkit_session_reason" == viewer ]]; then
      report_process_exit "GNOME Shell Devkit (viewer exited)" "$devkit_shell_rc"
    else
      report_process_exit "GNOME Shell Devkit" "$devkit_shell_rc"
    fi
    return 125
  fi
  return 0
}

run_wayland_nested() {
  has_option gnome-shell --nested || return 1
  has_option gnome-shell --wayland || return 1

  local before shell_pid nested_display shell_rc killed
  before="$(find "$FEDORA_SESSION_RUNTIME" -maxdepth 1 -type s -name 'wayland-*' -exec basename {} \; 2>/dev/null || true)"
  session_log "Starting GNOME Shell nested Wayland on outer DISPLAY=$DISPLAY"
  local shell_args=(--nested --wayland)
  if ! nested_xwayland_enabled && has_option gnome-shell --no-x11; then
    shell_args+=(--no-x11)
    session_log "Inner Xwayland disabled for the nested compositor (outer Termux:X11 viewer remains enabled)"
  fi
  if has_option gnome-shell --sm-disable; then
    shell_args+=(--sm-disable)
  fi
  if [[ "$FEDORA_NESTED_SCALE" != 1 ]]; then
    export MUTTER_DEBUG_DUMMY_MONITOR_SCALES="$FEDORA_NESTED_SCALE"
  fi
  if [[ -n "${FEDORA_NESTED_MODE_SPECS:-}" ]]; then
    export MUTTER_DEBUG_DUMMY_MODE_SPECS="$FEDORA_NESTED_MODE_SPECS"
  fi

  unset WAYLAND_DISPLAY
  gnome-shell "${shell_args[@]}" >> "$FEDORA_SESSION_LOG" 2>&1 &
  shell_pid="$!"
  child_pids+=("$shell_pid")

  if ! nested_display="$(wait_for_nested_socket "$before" "$shell_pid")"; then
    session_log "GNOME Shell did not publish a nested Wayland socket"
    killed=0
    if process_is_live "$shell_pid"; then
      kill "$shell_pid" 2>/dev/null || true
      killed=1
    fi
    shell_rc=0
    wait "$shell_pid" 2>/dev/null || shell_rc=$?
    if (( ! killed && shell_rc != 0 )); then
      report_process_exit "GNOME Shell nested Wayland" "$shell_rc"
      return 125
    fi
    return 1
  fi
  export WAYLAND_DISPLAY="$nested_display"
  export XDG_SESSION_TYPE=wayland
  atomic_session_write "$FEDORA_SESSION_RUNTIME/fedora-session-state.env" 600 <<EOF || {
WAYLAND_DISPLAY=$(printf '%q' "$WAYLAND_DISPLAY")
XDG_RUNTIME_DIR=$(printf '%q' "$XDG_RUNTIME_DIR")
XDG_SESSION_TYPE=$(printf '%q' "$XDG_SESSION_TYPE")
DISPLAY=$(printf '%q' "$DISPLAY")
FEDORA_KEYBOARD_MODE=$(printf '%q' "$FEDORA_KEYBOARD_MODE")
EOF
    session_log "ERROR: could not publish a safe Fedora Wayland session state"
    if process_is_live "$shell_pid"; then
      kill "$shell_pid" 2>/dev/null || true
    fi
    wait "$shell_pid" 2>/dev/null || true
    return 125
  }
  session_log "Desktop session: Wayland ($WAYLAND_DISPLAY); transport: X11 ($DISPLAY)"

  start_settings_daemon
  start_session_terminal
  shell_rc=0
  wait "$shell_pid" || shell_rc=$?
  if (( shell_rc != 0 )); then
    report_process_exit "GNOME Shell nested Wayland" "$shell_rc"
    return 125
  fi
  return 0
}

release_devkit_pipewire_for_nested_fallback() {
  # The nested GNOME compositor does not use Mutter Devkit's screen-cast
  # viewer. In the conservative 12-GiB/off-portal profile, release the
  # short-lived display-only PipeWire server before retrying nested Wayland.
  # Keep it when audio or portals were explicitly requested because those
  # callers may still need the native PipeWire endpoint.
  [[ "$FEDORA_MEMORY_PROFILE" == low ]] || return 0
  case "$FEDORA_AUDIO_MODE" in
    off|disabled|none|auto) ;;
    *) return 0 ;;
  esac
  case "$FEDORA_PORTAL_MODE" in
    off|disabled|none)
      [[ -n "$pipewire_pid" ]] || return 0
      session_log "Releasing Devkit-only PipeWire before nested Wayland retry (low memory, audio/portals off)"
      stop_pipewire_process
      ;;
    *)
      return 0
      ;;
  esac
}

run_x11_fallback() {
  fedora_is_true "$FEDORA_ALLOW_X11" || return 1
  has_option gnome-shell --x11 || return 1
  export XDG_SESSION_TYPE=x11
  unset WAYLAND_DISPLAY
  session_log "WARNING: explicit temporary GNOME X11 fallback enabled"
  local shell_args=(--x11)
  if has_option gnome-shell --sm-disable; then
    shell_args+=(--sm-disable)
  fi
  gnome-shell "${shell_args[@]}" >> "$FEDORA_SESSION_LOG" 2>&1 &
  local shell_pid="$!"
  child_pids+=("$shell_pid")
  local shell_rc=0
  wait "$shell_pid" || shell_rc=$?
  if (( shell_rc != 0 )); then
    report_process_exit "GNOME Shell X11 fallback" "$shell_rc"
    return 125
  fi
  return 0
}

fedora_is_true() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

case "$FEDORA_NESTED_MODE" in
  wayland|auto)
    if run_wayland_devkit; then
      exit 0
    else
      devkit_rc=$?
    fi
    if (( devkit_rc == 125 )); then
      session_die "GNOME Shell Devkit crashed; see $FEDORA_SESSION_LOG"
    fi
    if (( devkit_rc == 1 )); then
      release_devkit_pipewire_for_nested_fallback
    fi
    if run_wayland_nested; then
      exit 0
    else
      nested_rc=$?
    fi
    if (( nested_rc == 125 )); then
      session_die "GNOME Shell nested Wayland crashed; see $FEDORA_SESSION_LOG"
    fi
    if [[ "$FEDORA_NESTED_MODE" == wayland ]]; then
      session_die "GNOME nested Wayland is unavailable; refusing silent X11 fallback"
    fi
    session_log "Mutter-only nested transport is not a GNOME desktop; refusing to report it as a successful session"
    ;;
  mutter)
    session_die "FEDORA_NESTED_MODE=mutter is transport-only and cannot provide GNOME Shell; use wayland or auto"
    ;;
  x11)
    if run_x11_fallback; then
      exit 0
    else
      x11_rc=$?
    fi
    if (( x11_rc == 125 )); then
      session_die "GNOME Shell X11 fallback crashed; see $FEDORA_SESSION_LOG"
    fi
    session_die "explicit X11 fallback requested but unavailable"
    exit 0
    ;;
  *)
    session_die "Unknown FEDORA_NESTED_MODE=$FEDORA_NESTED_MODE"
    ;;
esac

if run_x11_fallback; then
  exit 0
else
  x11_rc=$?
fi
if (( x11_rc == 125 )); then
  session_die "GNOME Shell X11 fallback crashed; see $FEDORA_SESSION_LOG"
fi

session_die "No supported GNOME display mode found. GNOME 49+ needs --devkit and mutter-devkit; see $FEDORA_SESSION_LOG"
