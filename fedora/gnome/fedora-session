configure_search_mode() {
  local mode="$FEDORA_SEARCH_MODE"
  if [[ "$mode" == auto ]]; then
    if [[ "$FEDORA_MEMORY_PROFILE" == low ]]; then
      mode=off
    else
      session_log "GNOME search indexing left at the user's current setting"
      return 0
    fi
  fi
  case "$mode" in
    off|disabled|none)
      backup_fedora_settings
      session_log "GNOME search indexing disabled for memory profile $FEDORA_MEMORY_PROFILE"
      if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.freedesktop.Tracker3.Miner.Files enable-monitors false \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
        gsettings set org.freedesktop.Tracker3.Miner.Files crawling-interval -2 \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
        gsettings set org.gnome.desktop.search-providers disable-external true \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
      fi
      if command -v tracker3 >/dev/null 2>&1; then
        tracker3 daemon --terminate >> "$FEDORA_SESSION_LOG" 2>&1 || true
      fi
      ;;
    on|enabled)
      backup_fedora_settings
      session_log "GNOME search indexing explicitly enabled"
      if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.freedesktop.Tracker3.Miner.Files enable-monitors true \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
        gsettings set org.freedesktop.Tracker3.Miner.Files crawling-interval 15 \
          >> "$FEDORA_SESSION_LOG" 2>&1 || true
      fi
      ;;
    *)
      session_log "Unknown FEDORA_SEARCH_MODE=$FEDORA_SEARCH_MODE; leaving search indexing unchanged"
      ;;
  esac
}

disable_unsupported_system_integrations() {
  # GNOME 50 creates TimeLimitsManager during Shell startup. If the Fedora
  # guest has the screen-time history key enabled, that manager asks for a
  # systemd/logind user proxy. PRoot has no logind service even though the
  # Fedora-local compatibility bus makes Gio.DBus.system connectable. This is a
  # Fedora-local setting; Android Digital Wellbeing and Android parental
  # controls are not touched.
  if command -v gsettings >/dev/null 2>&1; then
    backup_fedora_settings
    if gsettings set org.gnome.desktop.screen-time-limits history-enabled false \
      >> "$FEDORA_SESSION_LOG" 2>&1; then
      session_log "GNOME screen-time history disabled: logind is unavailable in Fedora/PRoot"
    fi
    if gsettings set org.gnome.desktop.screen-time-limits daily-limit-enabled false \
      >> "$FEDORA_SESSION_LOG" 2>&1; then
      session_log "GNOME daily screen-time limit disabled: logind is unavailable in Fedora/PRoot"
    fi
  fi
}

sync_android_app_desktops() {
  case "$FEDORA_ANDROID_APPS_SCOPE" in
    user|all) ;;
    *)
      session_log "Unknown FEDORA_ANDROID_APPS_SCOPE=$FEDORA_ANDROID_APPS_SCOPE; using user scope"
      FEDORA_ANDROID_APPS_SCOPE=user
      ;;
  esac
  case "$FEDORA_ANDROID_APPS_MODE" in
    off|disabled|none|0|false|no)
      session_log "Android application entries disabled (FEDORA_ANDROID_APPS_MODE=$FEDORA_ANDROID_APPS_MODE)"
      return 0
      ;;
    on|enabled|1|true|yes|auto)
      ;;
    *)
      session_log "Unknown FEDORA_ANDROID_APPS_MODE=$FEDORA_ANDROID_APPS_MODE; keeping existing Android entries"
      return 0
      ;;
  esac
  if [[ ! -x /usr/local/bin/fedora-android-bridge \
    || -L /usr/local/bin/fedora-android-bridge ]]; then
    session_log "Android application bridge is not installed; keeping existing Android entries"
    return 0
  fi
  if [[ ! -d "$FEDORA_ANDROID_BRIDGE_DIR" \
    || -L "$FEDORA_ANDROID_BRIDGE_DIR" \
    || ! -d "$FEDORA_ANDROID_BRIDGE_DIR/requests" \
    || -L "$FEDORA_ANDROID_BRIDGE_DIR/requests" \
    || ! -d "$FEDORA_ANDROID_BRIDGE_DIR/responses" \
    || -L "$FEDORA_ANDROID_BRIDGE_DIR/responses" ]]; then
    session_log "Android application broker is unavailable; keeping existing Android entries"
    return 0
  fi

  local output="" rc=0
  # Startup enumeration is intentionally shorter than an explicit user
  # command: a missing/stopped Termux broker must never delay GNOME for the
  # full interactive timeout. A failed refresh leaves the previous catalog in
  # place; it never deletes Android or Fedora applications.
  if output="$(FEDORA_ANDROID_BRIDGE_TIMEOUT="${FEDORA_ANDROID_BRIDGE_TIMEOUT:-3}" \
    FEDORA_ANDROID_APPS_SCOPE="$FEDORA_ANDROID_APPS_SCOPE" \
    /usr/local/bin/fedora-android-bridge sync-apps 2>&1)"; then
    [[ -z "$output" ]] || session_log "$output"
  else
    rc=$?
    session_log "Android application catalog refresh failed (exit $rc); existing entries were preserved"
    [[ -z "$output" ]] || session_log "$output"
  fi
}

child_pids=()
system_bus_pid=""
system_bus_socket="$FEDORA_SESSION_RUNTIME/system-bus"
system_bus_config_path="$FEDORA_SESSION_RUNTIME/dbus-system-compat.conf"
system_bus_pid_file="$FEDORA_SESSION_RUNTIME/system-bus.pid"
system_bus_address=""
pipewire_pid=""
pipewire_config_path=""
pipewire_pid_file="$FEDORA_SESSION_RUNTIME/pipewire.pid"

pipewire_process_alive() {
  local pid="$1"
  local process_name=""
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  process_is_live "$pid" || return 1
  [[ -r "/proc/$pid/comm" ]] || return 1
  process_name="$(<"/proc/$pid/comm")"
  [[ "$process_name" == pipewire ]]
}

remove_stale_pipewire_state() {
  local old_pid=""
  local tries=0
  if [[ -L "$pipewire_pid_file" \
    || ( -e "$pipewire_pid_file" && ! -f "$pipewire_pid_file" ) ]]; then
    session_log "ERROR: refusing unsafe project PipeWire PID file: $pipewire_pid_file"
    return 1
  fi
  if [[ -r "$pipewire_pid_file" ]]; then
    old_pid="$(sed -n '1p' "$pipewire_pid_file" 2>/dev/null || true)"
    if pipewire_process_alive "$old_pid"; then
      session_log "Stopping stale project PipeWire process $old_pid"
      kill "$old_pid" 2>/dev/null || true
      while pipewire_process_alive "$old_pid" && (( tries < 20 )); do
        sleep 0.1
        ((tries += 1))
      done
      if pipewire_process_alive "$old_pid"; then
        kill -KILL "$old_pid" 2>/dev/null || true
      fi
    fi
  fi
  rm -f -- "$pipewire_pid_file" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0.lock" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0-manager" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0-manager.lock"
}

stop_pipewire_process() {
  local pid="$pipewire_pid"
  local tries=0
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  if pipewire_process_alive "$pid"; then
    kill "$pid" 2>/dev/null || true
    while pipewire_process_alive "$pid" && (( tries < 20 )); do
      sleep 0.1
      ((tries += 1))
    done
    if pipewire_process_alive "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  wait "$pid" 2>/dev/null || true
  pipewire_pid=""
  rm -f -- "$pipewire_pid_file"
}

cleanup() {
  local pid tries
  stop_private_system_bus
  for pid in "${child_pids[@]:-}"; do
    if [[ "$pid" =~ ^[0-9]+$ ]] && process_is_live "$pid"; then
      kill "$pid" 2>/dev/null || true
      tries=0
      while process_is_live "$pid" && (( tries < 20 )); do
        sleep 0.1
        ((tries += 1))
      done
      if process_is_live "$pid"; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
      wait "$pid" 2>/dev/null || true
    fi
  done
  rm -f -- "$FEDORA_SESSION_RUNTIME/fedora-session-state.env" \
    "$pipewire_pid_file" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0.lock" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0-manager" \
    "$FEDORA_SESSION_RUNTIME/pipewire-0-manager.lock"
  restore_fedora_settings
  restore_stale_systemd_marker
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Install the cleanup trap before hiding the Fedora-only systemd marker or
# changing Fedora-local dconf values. A failure in optional setup must never
# leave those reversible guest-only changes behind.
hide_stale_systemd_marker
if ! start_private_system_bus; then
  session_die "Fedora-private system D-Bus compatibility bus is unavailable; see $FEDORA_SESSION_LOG"
fi
session_log "Memory profile: $FEDORA_MEMORY_PROFILE; audio=$FEDORA_AUDIO_MODE settings=$FEDORA_SETTINGS_DAEMON terminal=$FEDORA_LAUNCH_TERMINAL keyring=$FEDORA_KEYRING_MODE search=$FEDORA_SEARCH_MODE calendar=$FEDORA_CALENDAR_MODE xwayland=$FEDORA_NESTED_XWAYLAND android_apps=$FEDORA_ANDROID_APPS_MODE scope=$FEDORA_ANDROID_APPS_SCOPE keyboard=$FEDORA_KEYBOARD_MODE"
configure_search_mode
disable_unsupported_system_integrations
sync_android_app_desktops

start_optional() {
  local name="$1"
  shift
  local executable=""
  if executable="$(command -v "$name" 2>/dev/null)"; then
    :
  elif [[ -x "/usr/libexec/$name" ]]; then
    executable="/usr/libexec/$name"
  else
    session_log "optional process not installed: $name"
    return 0
  fi
  "$executable" "$@" >> "$FEDORA_SESSION_LOG" 2>&1 &
  local child_pid="$!"
  child_pids+=("$child_pid")
  if [[ "$name" == pipewire ]]; then
    pipewire_pid="$child_pid"
    if ! atomic_session_write "$pipewire_pid_file" 600 <<< "$child_pid"; then
      session_log "ERROR: could not record the Fedora PipeWire PID safely"
      kill "$child_pid" 2>/dev/null || true
      wait "$child_pid" 2>/dev/null || true
      pipewire_pid=""
      return 1
    fi
  fi
}

wayland_transport_requested() {
  case "$FEDORA_NESTED_MODE" in
    x11|mutter) return 1 ;;
    *) return 0 ;;
  esac
}

pipewire_socket_ready() {
  # Mutter Devkit calls pw_context_connect() on the normal native server, not
  # the manager endpoint. A manager socket alone is not a usable compositor
  # transport and was the source of a false "ready" result.
  [[ -S "$FEDORA_SESSION_RUNTIME/pipewire-0" \
    && ! -L "$FEDORA_SESSION_RUNTIME/pipewire-0" ]]
}

start_minimal_pipewire_for_devkit() {
  wayland_transport_requested || return 0
  case "$FEDORA_DEVKIT_PIPEWIRE" in
    off|disabled|none|0|false|no)
      session_log "Mutter Devkit PipeWire transport disabled (FEDORA_DEVKIT_PIPEWIRE=$FEDORA_DEVKIT_PIPEWIRE); Wayland Devkit cannot start"
      return 1
      ;;
    auto|on|enabled|1|true|yes)
      session_log "Starting minimal PipeWire display transport; full audio helpers remain disabled"
      command -v pipewire >/dev/null 2>&1 || {
        session_log "PipeWire binary is missing; install pipewire in the Fedora container"
        return 1
      }
      command -v pw-cli >/dev/null 2>&1 || {
        session_log "PipeWire native client probe is missing; install pipewire-utils in the Fedora container"
        return 1
      }
      pipewire_config_path=""
      case "$FEDORA_DEVKIT_PIPEWIRE_CONFIG" in
        off|disabled|none)
          session_log "Using Fedora's default PipeWire configuration"
          ;;
        *)
          if [[ -r "$FEDORA_DEVKIT_PIPEWIRE_CONFIG" ]]; then
            pipewire_config_path="$FEDORA_DEVKIT_PIPEWIRE_CONFIG"
            session_log "Using isolated Devkit PipeWire configuration: $pipewire_config_path"
          else
            session_log "Isolated Devkit PipeWire configuration is missing: $FEDORA_DEVKIT_PIPEWIRE_CONFIG; using Fedora's default"
          fi
          ;;
      esac
      if [[ -n "$pipewire_config_path" ]]; then
        start_optional pipewire -c "$pipewire_config_path"
      else
        start_optional pipewire
      fi
      ;;
    *)
      session_log "Unknown FEDORA_DEVKIT_PIPEWIRE=$FEDORA_DEVKIT_PIPEWIRE; skipping minimal PipeWire display transport"
      return 1
      ;;
  esac
}

pipewire_client_probe() {
  command -v pw-cli >/dev/null 2>&1 || return 1
  local probe_log="$FEDORA_SESSION_RUNTIME/pipewire-probe.log"
  session_path_parents_safe "$probe_log" || return 1
  if [[ -L "$probe_log" || ( -e "$probe_log" && ! -f "$probe_log" ) ]]; then
    session_log "ERROR: refusing unsafe PipeWire probe log: $probe_log"
    return 1
  fi
  : > "$probe_log"
  if command -v timeout >/dev/null 2>&1; then
    timeout 4 env \
      XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME" \
      PIPEWIRE_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME" \
      PIPEWIRE_REMOTE="$PIPEWIRE_REMOTE" \
      PIPEWIRE_CORE="$PIPEWIRE_CORE" \
      pw-cli -r "$PIPEWIRE_REMOTE" info 0 > "$probe_log" 2>&1
  else
    env \
      XDG_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME" \
      PIPEWIRE_RUNTIME_DIR="$FEDORA_SESSION_RUNTIME" \
      PIPEWIRE_REMOTE="$PIPEWIRE_REMOTE" \
      PIPEWIRE_CORE="$PIPEWIRE_CORE" \
      pw-cli -r "$PIPEWIRE_REMOTE" info 0 > "$probe_log" 2>&1
  fi
}

wait_for_pipewire() {
  wayland_transport_requested || return 0
  case "$FEDORA_DEVKIT_PIPEWIRE" in
    off|disabled|none|0|false|no) return 1 ;;
  esac
  [[ -n "$pipewire_pid" ]] || return 1
  command -v pw-cli >/dev/null 2>&1 || {
    session_log "PipeWire native client probe is missing; install pipewire-utils in the Fedora container"
    return 1
  }
  local tries=0
  local probe_rc=0
  while (( tries < 50 )); do
    probe_rc=0
    if pipewire_socket_ready; then
      pipewire_client_probe || probe_rc=$?
      if (( probe_rc == 0 )); then
        session_log "PipeWire display transport is ready: $PIPEWIRE_RUNTIME_DIR/$PIPEWIRE_REMOTE"
        return 0
      fi
    fi
    if ! process_is_live "$pipewire_pid"; then
      session_log "PipeWire exited before accepting native clients; see $FEDORA_SESSION_RUNTIME/pipewire-probe.log"
      return 1
    fi
    sleep 0.1
    ((tries += 1))
  done
  session_log "PipeWire did not accept a native client within 5 seconds; see $FEDORA_SESSION_RUNTIME/pipewire-probe.log"
  return 1
}

# PipeWire and portals are user processes here. Mutter Devkit itself is a
# PipeWire screen-cast client, so a minimal PipeWire server is mandatory even
# when the user has disabled audio. The low-memory profile therefore omits
# WirePlumber and pipewire-pulse, but keeps this one small display transport.
start_audio_stack() {
  case "$FEDORA_AUDIO_MODE" in
    off|disabled|none)
      session_log "Audio stack disabled (FEDORA_AUDIO_MODE=$FEDORA_AUDIO_MODE)"
      start_minimal_pipewire_for_devkit
      ;;
    on|enabled)
      start_optional pipewire
      start_optional wireplumber
      start_optional pipewire-pulse
      ;;
    auto)
      if [[ "$FEDORA_MEMORY_PROFILE" == low ]]; then
        session_log "Full audio stack skipped by low memory profile; keeping minimal PipeWire for Mutter Devkit"
        start_minimal_pipewire_for_devkit
      else
        start_optional pipewire
        start_optional wireplumber
        start_optional pipewire-pulse
      fi
      ;;
    *)
      session_log "Unknown FEDORA_AUDIO_MODE=$FEDORA_AUDIO_MODE; audio stack disabled"
      start_minimal_pipewire_for_devkit
      ;;
  esac
  if wait_for_pipewire; then
    return 0
  fi
  if [[ -n "$pipewire_config_path" ]]; then
    session_log "Isolated Devkit PipeWire server did not pass the native probe; retrying once with Fedora's default configuration"
    stop_pipewire_process
    remove_stale_pipewire_state
    pipewire_config_path=""
    start_optional pipewire
    wait_for_pipewire && return 0
  fi
  return 1
}
remove_stale_pipewire_state
if ! start_audio_stack; then
  session_die "PipeWire native display transport is unavailable; see $FEDORA_SESSION_RUNTIME/pipewire-probe.log and $FEDORA_SESSION_LOG"
fi

