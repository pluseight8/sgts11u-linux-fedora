update_dbus_activation_environment() {
  command -v dbus-update-activation-environment >/dev/null 2>&1 || {
    session_log "dbus-update-activation-environment is unavailable; Devkit viewer may inherit the parent GTK backend"
    return 0
  }
  local activation_backend activation_wayland
  if (( $# >= 1 )); then
    activation_backend="$1"
  else
    activation_backend="${GDK_BACKEND:-}"
  fi
  if (( $# >= 2 )); then
    activation_wayland="$2"
  else
    activation_wayland="${WAYLAND_DISPLAY:-}"
  fi
  local -a environment=(
    "DISPLAY=$DISPLAY"
    "GDK_BACKEND=$activation_backend"
    "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-GNOME}"
    "XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP:-gnome}"
    "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-wayland}"
    "PIPEWIRE_RUNTIME_DIR=$PIPEWIRE_RUNTIME_DIR"
    "PIPEWIRE_REMOTE=$PIPEWIRE_REMOTE"
    "PIPEWIRE_CORE=$PIPEWIRE_CORE"
    "DBUS_SYSTEM_BUS_ADDRESS=${DBUS_SYSTEM_BUS_ADDRESS:-}"
    "FEDORA_KEYBOARD_MODE=$FEDORA_KEYBOARD_MODE"
    "XKB_CONFIG_ROOT=${XKB_CONFIG_ROOT:-}"
  )
  # dbus-update-activation-environment cannot unset a variable once it has
  # entered the daemon's environment. An empty value is the portable way to
  # prevent a D-Bus-activated X11 viewer from selecting a stale Wayland socket;
  # the direct GNOME Shell process was already given a genuinely unset value
  # above.
  environment+=("WAYLAND_DISPLAY=$activation_wayland")
  if ! dbus-update-activation-environment "${environment[@]}" \
    >> "$FEDORA_SESSION_LOG" 2>&1; then
    session_log "Could not update the private D-Bus activation environment for the Devkit viewer"
  fi
}

session_option_enabled() {
  local requested="$1"
  case "$requested" in
    on|enabled|1|true|yes) return 0 ;;
    off|disabled|none|0|false|no) return 1 ;;
    auto) [[ "$FEDORA_MEMORY_PROFILE" != low ]] ;;
    *) return 1 ;;
  esac
}

nested_xwayland_enabled() {
  case "$FEDORA_NESTED_XWAYLAND" in
    on|enabled|1|true|yes) return 0 ;;
    off|disabled|none|0|false|no) return 1 ;;
    auto) [[ "$FEDORA_MEMORY_PROFILE" != low ]] ;;
    *)
      session_log "Unknown FEDORA_NESTED_XWAYLAND=$FEDORA_NESTED_XWAYLAND; disabling inner Xwayland for safety"
      return 1
      ;;
