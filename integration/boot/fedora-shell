#!/data/data/com.termux/files/usr/bin/bash

# fedora-shell-boot-v1
set -Eeuo pipefail

# Termux:Boot runs while Android is still deciding which visible Home activity
# to show. Starting Termux:X11/PRoot here creates a hidden Fedora workload,
# consumes RAM, and can be rejected by Android's background-activity policy.
# The selected Fedora Shell Home activity owns the visible launch instead.
# Keep this compatibility hook as a safe no-op so installations that
# previously enabled --enable-boot cannot resurrect the old hidden launcher.
exit 0
